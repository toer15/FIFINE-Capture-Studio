<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FifineCaptureStudio</AssemblyName>
    <RootNamespace>FifineCaptureStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Version>1.0.0</Version>
    <!-- Keep assembly identity stable across patches; file/product versions follow $(Version). -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <StartupObject>FifineCaptureStudio.Program</StartupObject>
    <!-- Owner/repo used by the in-app Velopack update source. Overridable per build. -->
    <GitHubRepository Condition="'$(GitHubRepository)' == ''">toer15/FIFINE-Capture-Studio</GitHubRepository>
    <RepositoryUrl>https://github.com/$(GitHubRepository)</RepositoryUrl>
    <Product>FIFINE Capture Studio</Product>
    <Company>FIFINE</Company>
    <Description>Low-latency gaming capture and recording studio for PC, PlayStation 5 and Xbox.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>Assets\fifine.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Update="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GitHubRepository" Value="$(GitHubRepository)" />
  </ItemGroup>

</Project>
