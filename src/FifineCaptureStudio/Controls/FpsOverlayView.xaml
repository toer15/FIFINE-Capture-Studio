<UserControl x:Class="FifineCaptureStudio.Controls.FpsOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             HorizontalAlignment="{Binding FpsOverlayCorner, Converter={StaticResource OverlayHorizontal}}"
             VerticalAlignment="{Binding FpsOverlayCorner, Converter={StaticResource OverlayVertical}}"
             Margin="18"
             Visibility="{Binding FpsOverlayShown, Converter={StaticResource BoolToVis}}">
    <Border Background="#D9080D18" BorderBrush="#663A4A6A" BorderThickness="1" CornerRadius="10"
            Padding="12,8">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding FpsOverlayScale}" ScaleY="{Binding FpsOverlayScale}" />
        </Border.LayoutTransform>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel MinWidth="96">
                    <TextBlock Text="GAME FPS" FontSize="9.5" Foreground="#FF9AB7D9" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GameFpsDisplay}" FontSize="24" FontWeight="Bold"
                               Foreground="#FF7CF0BE" LineHeight="26" />
                </StackPanel>
                <Border Width="1" Background="#334A5E7E" Margin="12,2,12,2" />
                <StackPanel MinWidth="96">
                    <TextBlock Text="FRAME GEN" FontSize="9.5" Foreground="#FF9AB7D9" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FrameGenOutputDisplay}" FontSize="24" FontWeight="Bold"
                               Foreground="#FF8FE9FF" LineHeight="26" />
                </StackPanel>
                <Border Width="1" Background="#334A5E7E" Margin="12,2,12,2" />
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,1">
                    <TextBlock Text="{Binding GameFpsQualifier}" FontSize="9" Foreground="#FFB7C6DC" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="GEN " FontSize="9.5" Foreground="#FF7E8DA3" />
                        <TextBlock Text="{Binding GeneratedFpsDisplay}" FontSize="10.5" Foreground="#FFE7EDF7" />
                        <TextBlock Text="   PRES " FontSize="9.5" Foreground="#FF7E8DA3" />
                        <TextBlock Text="{Binding PresentedFpsDisplay}" FontSize="10.5" Foreground="#FFE7EDF7" />
                        <TextBlock Text="   IN " FontSize="9.5" Foreground="#FF7E8DA3" />
                        <TextBlock Text="{Binding InputFpsDisplay}" FontSize="10.5" Foreground="#FFE7EDF7" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
