<Window x:Class="FifineCaptureStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:FifineCaptureStudio.Views"
        Title="FIFINE Capture Studio"
        Width="1600" Height="920" MinWidth="1180" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource BodyFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="NavListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="43" Margin="10,2">
                            <Border x:Name="Bg" CornerRadius="11" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" />
                            <Border x:Name="Bar" Width="3" Height="19" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentGradient}" Opacity="0" />
                            <StackPanel Orientation="Horizontal" Margin="17,0,6,0" VerticalAlignment="Center">
                                <Path x:Name="Icon" Data="{Binding IconKey, Converter={StaticResource KeyToGeometry}}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" Width="18" Height="18"
                                      Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="{Binding Title}" Margin="13,0,0,0" FontSize="12.8" FontWeight="Medium"
                                           VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF111928" />
                                <Setter Property="Foreground" Value="#FFD8DEEE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavActive}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF2D2B57" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitlePill" TargetType="Border">
            <Setter Property="Background" Value="#FF0E1523" />
            <Setter Property="BorderBrush" Value="{StaticResource LineSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="11,0" />
        </Style>

        <Style x:Key="TitlePillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFD9DFEC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="StatusItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0" />
        </Style>

        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#FF8A95A9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#FFDCE2EE" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style x:Key="VLine" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="#FF1B2332" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF1A2231" BorderThickness="1" Background="{StaticResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <!-- ============================= TITLE BAR ============================= -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <views:BrandMark Width="30" Height="15" VerticalAlignment="Center" />
                    <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FIFINE" FontFamily="{StaticResource DisplayFont}" FontSize="13.5"
                                   FontWeight="Bold" Foreground="{StaticResource Text}" />
                        <TextBlock Text="Capture Studio" FontSize="11.5" FontWeight="Medium"
                                   Foreground="#FFC9D0DE" Margin="0,-1,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Height="24" Background="#FF1C2434" Margin="4,0,14,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- device connection -->
                    <Border Style="{StaticResource TitlePill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FF45D69A" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource TitlePillText}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TitlePill}" Margin="8,0,0,0" Background="#FF101726">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPad}" Stroke="#FFB2A8FF" StrokeThickness="1.6" Width="15" Height="15"
                                  Stretch="Uniform" VerticalAlignment="Center" StrokeLineJoin="Round" />
                            <TextBlock Text="{Binding PlatformTitle}" Style="{StaticResource TitlePillText}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TitlePill}" Margin="8,0,0,0" Background="#FF101726">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ResolutionLabel}" Style="{StaticResource TitlePillText}" />
                            <TextBlock Text="·" Style="{StaticResource TitlePillText}" Margin="7,0" Foreground="#FF5D6A83" />
                            <TextBlock Text="{Binding FpsChipLabel}" Style="{StaticResource TitlePillText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TitlePill}" Margin="8,0,0,0"
                            Background="#FF1C1119" BorderBrush="#FF3A1B26"
                            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Rec}" VerticalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                                                 Duration="0:0:0.9" AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="REC" Foreground="{StaticResource Rec}" FontWeight="Bold" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="7,0,6,0" />
                            <TextBlock Text="{Binding RecordingTimeText}" Style="{StaticResource TitlePillText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="3" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButton}" ToolTip="Notifications">
                            <Path Data="{StaticResource IconBell}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" ToolTip="Settings"
                                Command="{Binding NavigateCommand}" CommandParameter="settings" Margin="2,0,10,0">
                            <Path Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Border Style="{StaticResource VLine}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource WindowButton}" Click="Minimise_Click" ToolTip="Minimise">
                            <Path Data="M4,8 H16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" Width="14" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" Click="Maximise_Click" ToolTip="Maximise">
                            <Path Data="M4,4 H16 V16 H4 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                        <Button Click="Close_Click" ToolTip="Close">
                            <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" />
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFB3243F" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding AppVersion}" FontSize="9.5" Foreground="#FF5A6579"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,3" />
                </Grid>
            </Grid>

            <!-- ============================= BODY ============================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#FF0A0E18" BorderBrush="#FF161D2B" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0" ItemsSource="{Binding NavItems}" SelectedValuePath="Page"
                                 SelectedValue="{Binding CurrentPage, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                                 ItemContainerStyle="{StaticResource NavListItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                        <StackPanel Grid.Row="1" Margin="12,0,12,12">
                            <!-- brand card -->
                            <Border CornerRadius="14" Padding="14,12" Margin="0,0,0,8"
                                    BorderBrush="#FF2A2456" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF191333" Offset="0" />
                                        <GradientStop Color="#FF0D1220" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <views:BrandMark Width="46" Height="22" HorizontalAlignment="Left" />
                                    <TextBlock Text="FIFINE" FontFamily="{StaticResource DisplayFont}" FontSize="19"
                                               FontWeight="SemiBold" Foreground="#FFEDE9FF" Margin="0,4,0,0" />
                                    <TextBlock Text="Capture Studio" FontSize="11.5" Foreground="#FFB9B4E0" FontWeight="Medium" />
                                    <TextBlock Text="Capture · Play · Create" FontSize="10" Foreground="#FF6E6A94" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- low latency -->
                            <Border CornerRadius="12" Padding="11,9" Background="#FF0F1624" BorderBrush="#FF1E2739" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="8" Background="#FF1B2340" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconBolt}" Stroke="#FF8F84FF" StrokeThickness="1.5"
                                              Width="13" Height="13" Stretch="Uniform" StrokeLineJoin="Round" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="Low Latency Mode" FontSize="10.5" Foreground="#FFC7CEE0" FontWeight="Medium" />
                                        <TextBlock Text="{Binding LowLatencyBadge}" FontSize="9.5" Foreground="#FF6F7A90" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" Width="36" Height="20"
                                                  IsChecked="{Binding LowLatencyEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page host -->
                <ContentControl Grid.Column="1" x:Name="PageHost" Margin="0" />
            </Grid>

            <!-- ============================= STATUS BAR ============================= -->
            <Border Grid.Row="2" Background="#FF070910" BorderBrush="#FF161D2B" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Style="{StaticResource StatusItem}" Margin="8,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CaptureStateText}" Style="{StaticResource StatusValue}" Margin="7,0,0,0" Foreground="#FFE4EAF5" />
                        </StackPanel>
                        <Border Style="{StaticResource VLine}" />
                        <StackPanel Style="{StaticResource StatusItem}">
                            <TextBlock Text="Input:" Style="{StaticResource StatusLabel}" />
                            <TextBlock Text="{Binding InputResolutionLabel}" Style="{StaticResource StatusValue}" />
                            <TextBlock Text="{Binding FpsChipLabel}" Style="{StaticResource StatusValue}" Margin="4,0,0,0" Foreground="#FF9AA5B9" />
                        </StackPanel>
                        <Border Style="{StaticResource VLine}" />
                        <StackPanel Style="{StaticResource StatusItem}">
                            <TextBlock Text="Output:" Style="{StaticResource StatusLabel}" />
                            <TextBlock Text="{Binding OutputResolutionLabel}" Style="{StaticResource StatusValue}" />
                            <TextBlock Text="{Binding OutputFpsLabel}" Style="{StaticResource StatusValue}" Margin="4,0,0,0" Foreground="#FF9AA5B9" />
                        </StackPanel>
                        <Border Style="{StaticResource VLine}" />
                        <StackPanel Style="{StaticResource StatusItem}">
                            <TextBlock Text="Dropped Frames:" Style="{StaticResource StatusLabel}" />
                            <TextBlock Text="{Binding DroppedFramesText}" Style="{StaticResource StatusValue}" />
                        </StackPanel>
                        <Border Style="{StaticResource VLine}" />
                        <StackPanel Style="{StaticResource StatusItem}">
                            <Path Data="{StaticResource IconWave}" Stroke="#FF7F8CA2" StrokeThickness="1.5" Width="13" Height="13"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AudioStatusText}" Style="{StaticResource StatusValue}" Margin="7,0,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource VLine}" />
                        <StackPanel Style="{StaticResource StatusItem}">
                            <Path Data="{StaticResource IconDisk}" Stroke="#FF7F8CA2" StrokeThickness="1.5" Width="13" Height="13"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DiskFreeText}" Style="{StaticResource StatusValue}" Margin="7,0,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource VLine}" />
                        <StackPanel Style="{StaticResource StatusItem}">
                            <Path Data="{StaticResource IconClock}" Stroke="#FF7F8CA2" StrokeThickness="1.5" Width="13" Height="13"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LatencyText}" Style="{StaticResource StatusValue}" Margin="7,0,0,0" />
                            <TextBlock Text="preview" Style="{StaticResource StatusLabel}" Margin="4,0,0,0" Foreground="#FF5F6B80" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Path Data="{StaticResource IconChart}" Stroke="#FF7F8CA2" StrokeThickness="1.4" Width="13" Height="13"
                              Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="System:" Style="{StaticResource StatusLabel}" Margin="7,0,0,0" />
                        <TextBlock Text="{Binding SystemGrade}" Style="{StaticResource StatusValue}" Foreground="{StaticResource Green}" />
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================= OVERLAYS ============================= -->
            <Grid Grid.RowSpan="3" x:Name="OverlayLayer">
                <Border x:Name="WizardOverlay" Background="#E605070C" Visibility="{Binding ShowWizard, Converter={StaticResource BoolToVis}}">
                    <views:OnboardingWizard />
                </Border>
                <Border x:Name="PairingOverlay" Background="#D905070C" Visibility="{Binding IsPairingOpen, Converter={StaticResource BoolToVis}}">
                    <views:PairingDialog />
                </Border>
                <!-- update banner: only while an update is available / downloading / ready -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,22,58" Width="392"
                        Background="#F7121A29" CornerRadius="14" BorderBrush="#FF3A3566" BorderThickness="1" Padding="16,14"
                        Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" Opacity="0.6" ShadowDepth="7" Color="#FF000000" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FF35C9FF" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UpdateStatusText}" Foreground="#FF9BD7FF" FontSize="10.5" FontWeight="Bold"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LatestVersion}" Foreground="#FF7C879B" FontSize="10.5"
                                       HorizontalAlignment="Right" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateVersionHeadline}" Foreground="#FFEDF1F9" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UpdateVersionsLine}" Style="{StaticResource CaptionTiny}" Margin="0,4,0,0" />

                        <Grid Height="6" Margin="0,10,0,0" x:Name="UpdateTrack"
                              Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                            <Border Background="#FF1B2436" CornerRadius="3" />
                            <Border Background="#FF8B7BFF" CornerRadius="3" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressWidth}">
                                        <Binding Path="UpdateProgress" />
                                        <Binding Path="ActualWidth" ElementName="UpdateTrack" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding DownloadSizeText}" Style="{StaticResource CaptionTiny}" Margin="0,5,0,0"
                                   Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource AccentButton}" Height="30" Width="140" Content="Download"
                                    Command="{Binding DownloadUpdateCommand}"
                                    Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource AccentButton}" Height="30" Width="170" Content="Install and restart"
                                    Command="{Binding InstallUpdateCommand}"
                                    Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource GhostButton}" Height="30" Width="120" Margin="8,0,0,0" Content="Remind me later"
                                    Command="{Binding RemindLaterCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Toasts}" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                              Margin="0,0,22,54" Width="340">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="#F2121A29" BorderBrush="#FF2A3550" BorderThickness="1"
                                    Margin="0,8,0,0" Padding="12,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" Opacity="0.55" ShadowDepth="6" Color="#FF000000" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding Accent}" CornerRadius="2" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="10.5" Foreground="#FF7F8BA1" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#FFF1F4FA" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="12"
                        Background="#F0101727" BorderBrush="#FF2C3650" BorderThickness="1" Padding="16,10"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBolt}" Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyLabel}" Foreground="#FFE9EDF6" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
