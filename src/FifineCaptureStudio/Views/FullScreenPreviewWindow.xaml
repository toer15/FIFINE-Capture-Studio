<Window x:Class="FifineCaptureStudio.Views.FullScreenPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FifineCaptureStudio.Controls"
        Title="FIFINE Capture Studio — Preview"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="#FF000000" ShowInTaskbar="False"
        Cursor="None" PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="FsChip" TargetType="Border">
            <Setter Property="Background" Value="#B3000000" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="FsButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="#CC0B0F19" BorderBrush="#44FFFFFF"
                                BorderThickness="1" Width="38" Height="38">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#CC241E4A" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF8B7BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Black" MouseMove="OnMouseMove" MouseLeftButtonDown="OnRootClick">
        <Grid>
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding IsComparisonSingle, Converter={StaticResource BoolToVis}}" />
            <Grid Visibility="{Binding IsComparisonSplit, Converter={StaticResource BoolToVis}}">
                <Image Source="{Binding OriginalPreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <Border HorizontalAlignment="Right" ClipToBounds="True"
                        Width="{Binding ActualWidth, ElementName=Root, Converter={StaticResource HalfValue}}">
                    <Image Source="{Binding PreviewImage}" HorizontalAlignment="Right"
                           Width="{Binding ActualWidth, ElementName=Root}"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>
            <Grid Visibility="{Binding IsComparisonSideBySide, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding OriginalPreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <Rectangle Grid.Column="1" Fill="#FF8FE9FF" />
                <Image Grid.Column="2" Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Grid>

        <controls:FpsOverlayView Panel.ZIndex="30" />

        <!-- compact enhancement controls while gaming -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"
                Background="#B30A0F1A" BorderBrush="#553B4A6A" BorderThickness="1" CornerRadius="10" Padding="12,7"
                Visibility="{Binding EnhancementAvailable, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSparkle}" Stroke="#FF8FE9FF" StrokeThickness="1.5" Width="13" Height="13"
                      Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding EnhancementBadgeText}" Foreground="#FFE6ECF7" FontSize="11.5" Margin="7,0,10,0"
                           VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding EnhancementEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="Overlay" Opacity="0" IsHitTestVisible="False">
            <Grid>
                <!-- top status strip -->
                <Border VerticalAlignment="Top" Height="76" Margin="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B3000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="24,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource FsChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#FF45D69A" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ResolutionLabel}" Foreground="White" FontSize="12.5" Margin="7,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FsChip}">
                                <TextBlock Text="{Binding FpsChipLive}" Foreground="White" FontSize="12.5" />
                            </Border>
                            <Border Style="{StaticResource FsChip}" Background="#330F5138" BorderBrush="#5545D69A"
                                    Visibility="{Binding LowLatencyEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LowLatencyBadge}" Foreground="#FF7CF0BE" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource FsChip}" Background="#33FF4968" BorderBrush="#66FF4968"
                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#FFFF4968" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RecordingTimeText}" Foreground="#FFFFC2CD" FontSize="12.5"
                                               FontWeight="SemiBold" Margin="7,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FsChip}">
                                <TextBlock Text="{Binding LatencyText}" Foreground="#FF9BE9C8" FontSize="12" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource FsButton}" Click="ToggleMute_Click" Margin="0,0,8,0"
                                    ToolTip="Mute microphone">
                                <TextBlock Text="{Binding MicMuteLabel}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="#FFE6EBF5" />
                            </Button>
                            <Button Style="{StaticResource FsButton}" Click="Close_Click" ToolTip="Exit fullscreen (Esc)">
                                <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="#FFE6EBF5" StrokeThickness="1.6"
                                      Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Esc or F to exit fullscreen" Foreground="#99FFFFFF" FontSize="11.5"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" />
            </Grid>
        </Border>

    </Grid>
</Window>
