<UserControl x:Class="FifineCaptureStudio.Views.PairingDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <UserControl.Resources>
        <Style x:Key="PairLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF8D98AC" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="PairMetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#FF7C879B" />
        </Style>
        <Style x:Key="PairMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFE6EBF5" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="PairDeviceItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="9" Background="#FF101725" BorderBrush="#FF1E2740"
                                BorderThickness="1" Padding="11,8" Margin="0,0,0,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF3A4A67" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF1B1A3B" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF8B7BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#F7070A12" CornerRadius="18" BorderBrush="#FF2A3550" BorderThickness="1"
            Width="780" MaxHeight="700" HorizontalAlignment="Center" VerticalAlignment="Center"
            DataContext="{Binding Pairing}" x:Name="Card">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.75" ShadowDepth="10" Color="#FF000000" />
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96" />
        </Border.RenderTransform>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="46" Height="46" Margin="0,0,12,0">
                        <Ellipse x:Name="PulseRing" Width="46" Height="46" Stroke="#FF35C9FF" StrokeThickness="1.5" Opacity="0.25" />
                        <Ellipse Width="38" Height="38" Fill="#FF151B2B" Stroke="#FF8B7BFF" StrokeThickness="1.2" />
                        <TextBlock Text="{Binding PlatformGlyph}" FontSize="12" FontWeight="Bold" Foreground="#FFD9D2FF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlatformName, StringFormat=Pair {0}}" Foreground="#FFEDF1F9" FontSize="19" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StageLabel}" Foreground="{Binding StatusColor}" FontSize="11.5"
                                       FontWeight="SemiBold" Margin="7,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CancelCommand}" ToolTip="Close pairing">
                    <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="#FFD6DEEE" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- instructions -->
            <Border Grid.Row="1" Background="#FF111827" CornerRadius="11" BorderBrush="#FF232E46" BorderThickness="1"
                    Padding="13,11" Margin="0,16,0,0">
                <TextBlock Text="{Binding Instructions}" Style="{StaticResource Body}" TextWrapping="Wrap" FontSize="12.3" LineHeight="21" />
            </Border>

            <!-- discovery + manual address -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CONSOLE / AGENT ADDRESS" Style="{StaticResource PairLabel}" />
                    <TextBox Style="{StaticResource DarkText}" Height="34" Text="{Binding ManualAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Type the IP address when discovery cannot find the device." />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="34" Width="112" Margin="10,17,0,0"
                        Content="Search" Command="{Binding SearchCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Height="34" Width="176" Margin="8,17,0,0"
                        Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding CanConnect}" />
            </Grid>

            <!-- discovered devices -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="DISCOVERED DEVICES" Style="{StaticResource PairLabel}" />
                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource PairDeviceItem}" Background="Transparent" BorderThickness="0"
                         MaxHeight="126" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="#FFE6EBF5" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Transport}" Style="{StaticResource CaptionTiny}" Foreground="#FF9B8BFF"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Nothing found yet. Discovery only proves a host exists — it does not authenticate anything."
                           Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>

            <!-- one-time code -->
            <StackPanel Grid.Row="4" Margin="0,14,0,0" Visibility="{Binding AcceptsCode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding CodeLabel}" Style="{StaticResource PairLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource DarkText}" Height="44" Width="220" HorizontalAlignment="Left"
                             FontSize="21" FontFamily="Consolas" Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEnterCode}" MaxLength="12" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="Any length the console shows. The code is used for this attempt only — it is never written to disk." />
                </Grid>
            </StackPanel>

            <!-- status -->
            <Border Grid.Row="5" Background="#FF0E1420" CornerRadius="10" BorderBrush="#FF1E2740" BorderThickness="1"
                    Padding="12,10" Margin="0,14,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="#FFC9D3E4" />
            </Border>

            <!-- live metrics (only after real frames) -->
            <Border Grid.Row="6" Background="#FF0F2A22" CornerRadius="11" BorderBrush="#FF1F6B52" BorderThickness="1"
                    Padding="14,12" Margin="0,12,0,0"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="LIVE VIDEO VERIFIED" Foreground="#FF7CF0BE" FontSize="10.5" FontWeight="Bold" />
                    <UniformGrid Columns="5" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Resolution" Style="{StaticResource PairMetricLabel}" />
                            <TextBlock Text="{Binding LiveResolution}" Style="{StaticResource PairMetricValue}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Incoming FPS" Style="{StaticResource PairMetricLabel}" />
                            <TextBlock Text="{Binding LiveFps}" Style="{StaticResource PairMetricValue}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Audio" Style="{StaticResource PairMetricLabel}" />
                            <TextBlock Text="{Binding LiveAudio}" Style="{StaticResource PairMetricValue}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Latency" Style="{StaticResource PairMetricLabel}" />
                            <TextBlock Text="{Binding LiveLatency}" Style="{StaticResource PairMetricValue}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Quality" Style="{StaticResource PairMetricLabel}" />
                            <TextBlock Text="{Binding LiveQuality}" Style="{StaticResource PairMetricValue}" />
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource RecordButton}" Height="34" Width="150" Content="Start recording"
                                Command="{Binding DataContext.ToggleRecordingCommand, ElementName=Root}" />
                        <Button Style="{StaticResource GhostButton}" Height="34" Width="150" Margin="8,0,0,0" Content="Open fullscreen"
                                Command="{Binding DataContext.ToggleFullscreenCommand, ElementName=Root}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- fallback + trusted devices -->
            <Grid Grid.Row="7" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Visibility="{Binding ShowFallback, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="SUPPORTED PATH" Style="{StaticResource PairLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Height="32" Width="210" Content="Continue with HDMI capture card"
                                    Command="{Binding CaptureCardCommand}" />
                            <Button Style="{StaticResource GhostButton}" Height="32" Width="150" Margin="8,0,0,0" Content="Capture this PC"
                                    Command="{Binding PcDirectCommand}"
                                    Visibility="{Binding IsPc, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="This starts the existing capture engine and only reports success when frames are actually decoded."
                                   Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsPc, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="THIS PC" Style="{StaticResource PairLabel}" />
                        <Button Style="{StaticResource AccentButton}" Height="32" Width="190" HorizontalAlignment="Left"
                                Content="Capture this PC" Command="{Binding PcDirectCommand}" />
                    </StackPanel>

                    <TextBlock Text="TRUSTED DEVICES" Style="{StaticResource PairLabel}" Margin="0,14,0,0" />
                    <ItemsControl ItemsSource="{Binding TrustedDevices}" MaxHeight="80">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="24">
                                    <TextBlock Style="{StaticResource CaptionTiny}" VerticalAlignment="Center"
                                               Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource CaptionTiny}" Foreground="#FF7C879B" Margin="140,0,90,0"
                                               VerticalAlignment="Center" Text="{Binding Address}" />
                                    <Button Style="{StaticResource GhostButton}" Height="22" Width="76" HorizontalAlignment="Right"
                                            Content="Forget" FontSize="10"
                                            Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- footer -->
            <Grid Grid.Row="8" Margin="0,14,0,0">
                <TextBlock Style="{StaticResource CaptionTiny}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                           Text="FIFINE never sends pairing codes to a server, never stores console credentials, and never claims a connection before video frames arrive." />
                <Button Style="{StaticResource GhostButton}" Height="32" Width="110" HorizontalAlignment="Right"
                        Content="Close" Command="{Binding CancelCommand}" />
            </Grid>
        </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
