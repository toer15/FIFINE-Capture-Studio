<UserControl x:Class="FifineCaptureStudio.Views.AccountsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="16,14">
        <StackPanel>
            <TextBlock Text="Platform accounts" Style="{StaticResource CardTitle}" />
            <TextBlock Text="Account sign-in is independent of console discovery, pairing and streaming. Each platform keeps its own session."
                       Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,5,0,0" />

            <!-- Xbox / Microsoft -->
            <Border Style="{StaticResource InnerPanel}" Padding="11,10" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Xbox" Foreground="#FFE6EBF5" FontSize="12.5" FontWeight="SemiBold" />
                        <Border HorizontalAlignment="Right" Background="#1410" BorderBrush="{Binding XboxAccount.StatusColor}"
                                BorderThickness="1" CornerRadius="6" Padding="6,2">
                            <TextBlock Text="{Binding XboxAccount.StatusLabel}" Foreground="{Binding XboxAccount.StatusColor}"
                                       FontSize="9" FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding XboxAccount.ProviderLabel}" Style="{StaticResource CaptionTiny}" Margin="0,3,0,0" />

                    <StackPanel Visibility="{Binding XboxAccount.ShowSetup, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding XboxAccount.SetupMessage}" Style="{StaticResource CaptionTiny}"
                                   TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0" />
                        <TextBox Height="30" Padding="8,4" Margin="0,8,0,0" Background="#FF101725" Foreground="#FFE6EBF5"
                                 BorderBrush="#FF253048" BorderThickness="1"
                                 Text="{Binding XboxClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Xbox application client ID"
                                 ToolTip="Application (client) ID from the Microsoft Entra app registration." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource AccentButton}" Height="30" Width="112" FontSize="11"
                                    Content="Save client ID" Command="{Binding SaveXboxClientIdCommand}" />
                            <Button Style="{StaticResource GhostButton}" Height="30" Width="102" FontSize="11" Margin="8,0,0,0"
                                    Content="Open Azure" Command="{Binding OpenXboxSetupCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding XboxAccount.ShowSignedOut, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding XboxAccount.StatusText}" Style="{StaticResource CaptionTiny}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <Button Style="{StaticResource AccentButton}" Height="30" Width="170" HorizontalAlignment="Left"
                                Margin="0,8,0,0" FontSize="11" Content="Sign in with Microsoft"
                                Command="{Binding SignInXboxCommand}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding XboxAccount.ShowBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding XboxAccount.StatusText}" Style="{StaticResource CaptionTiny}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <StackPanel Visibility="{Binding XboxAccount.ShowDeviceCode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,8,0,0">
                            <TextBlock Text="CODE TO ENTER" Style="{StaticResource CaptionTiny}" FontWeight="Bold" Foreground="#FF9AB7D9" />
                            <TextBlock Text="{Binding XboxAccount.UserCode}" Foreground="White" FontFamily="Consolas"
                                       FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding XboxAccount.VerificationUri}" Style="{StaticResource CaptionTiny}"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <Button Style="{StaticResource GhostButton}" Height="30" Width="136" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" FontSize="11" Content="Open sign-in page"
                                    Command="{Binding OpenXboxVerificationCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding XboxAccount.ShowError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding XboxAccount.StatusText}" Foreground="#FFFF8FA3" FontSize="10.5"
                                   TextWrapping="Wrap" LineHeight="16" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding XboxAccount.LastAccountLine}" Style="{StaticResource CaptionTiny}"
                                   Visibility="{Binding XboxAccount.ShowLastAccount, Converter={StaticResource BoolToVis}}"
                                   Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource AccentButton}" Height="30" Width="118" FontSize="11"
                                    Content="Sign in again" Command="{Binding SignInXboxCommand}"
                                    Visibility="{Binding XboxAccount.ShowSignInButton, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource GhostButton}" Height="30" Width="86" FontSize="11" Margin="8,0,0,0"
                                    Content="Sign out" Command="{Binding SignOutXboxCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding XboxAccount.ShowSignedIn, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Signed in" Foreground="#FF45D69A" FontSize="11" FontWeight="SemiBold" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding XboxAccount.AccountLine}" Foreground="#FFE6EBF5" FontSize="12"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding XboxAccount.AccountIdLine}" Style="{StaticResource CaptionTiny}" Margin="0,2,0,0" />
                        <Button Style="{StaticResource GhostButton}" Height="30" Width="86" HorizontalAlignment="Left"
                                Margin="0,8,0,0" FontSize="11" Content="Sign out" Command="{Binding SignOutXboxCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- PlayStation Network -->
            <Border Style="{StaticResource InnerPanel}" Padding="11,10" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="PlayStation" Foreground="#FFE6EBF5" FontSize="12.5" FontWeight="SemiBold" />
                        <Border HorizontalAlignment="Right" Background="#1410" BorderBrush="{Binding PlayStationAccount.StatusColor}"
                                BorderThickness="1" CornerRadius="6" Padding="6,2">
                            <TextBlock Text="{Binding PlayStationAccount.StatusLabel}" Foreground="{Binding PlayStationAccount.StatusColor}"
                                       FontSize="9" FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding PlayStationAccount.ProviderLabel}" Style="{StaticResource CaptionTiny}" Margin="0,3,0,0" />

                    <StackPanel Visibility="{Binding PlayStationAccount.ShowSignedOut, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PlayStationAccount.StatusText}" Style="{StaticResource CaptionTiny}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <Button Style="{StaticResource AccentButton}" Height="30" Width="150" HorizontalAlignment="Left"
                                Margin="0,8,0,0" FontSize="11" Content="Sign in with Sony"
                                Command="{Binding SignInPsnCommand}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding PlayStationAccount.ShowBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PlayStationAccount.StatusText}" Style="{StaticResource CaptionTiny}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding PlayStationAccount.ShowError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PlayStationAccount.StatusText}" Foreground="#FFFF8FA3" FontSize="10.5"
                                   TextWrapping="Wrap" LineHeight="16" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding PlayStationAccount.LastAccountLine}" Style="{StaticResource CaptionTiny}"
                                   Visibility="{Binding PlayStationAccount.ShowLastAccount, Converter={StaticResource BoolToVis}}"
                                   Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource AccentButton}" Height="30" Width="118" FontSize="11"
                                    Content="Sign in again" Command="{Binding SignInPsnCommand}"
                                    Visibility="{Binding PlayStationAccount.ShowSignInButton, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource GhostButton}" Height="30" Width="86" FontSize="11" Margin="8,0,0,0"
                                    Content="Sign out" Command="{Binding SignOutPsnCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding PlayStationAccount.ShowSignedIn, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Signed in" Foreground="#FF45D69A" FontSize="11" FontWeight="SemiBold" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding PlayStationAccount.AccountLine}" Foreground="#FFE6EBF5" FontSize="12"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding PlayStationAccount.AccountIdLine}" Style="{StaticResource CaptionTiny}" Margin="0,2,0,0" />
                        <Button Style="{StaticResource GhostButton}" Height="30" Width="86" HorizontalAlignment="Left"
                                Margin="0,8,0,0" FontSize="11" Content="Sign out" Command="{Binding SignOutPsnCommand}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding PlayStationAccount.ShowManualAccountId, Converter={StaticResource BoolToVis}}"
                                Margin="0,9,0,0">
                        <TextBlock Text="PSN account ID (advanced, optional)" Style="{StaticResource CaptionTiny}" />
                        <TextBox Height="30" Padding="8,4" Margin="0,4,0,0" Background="#FF101725" Foreground="#FFE6EBF5"
                                 BorderBrush="#FF253048" BorderThickness="1"
                                 Text="{Binding PlayStationAccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="PSN account ID"
                                 ToolTip="Hex or base64 PSN account ID. A signed-in account fills this automatically; this field alone does not authenticate an account." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- PC -->
            <Border Style="{StaticResource InnerPanel}" Padding="11,10" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="PC" Foreground="#FFE6EBF5" FontSize="12.5" FontWeight="SemiBold" />
                        <Border HorizontalAlignment="Right" Background="#1410" BorderBrush="{Binding PcAccount.StatusColor}"
                                BorderThickness="1" CornerRadius="6" Padding="6,2">
                            <TextBlock Text="{Binding PcAccount.StatusLabel}" Foreground="{Binding PcAccount.StatusColor}"
                                       FontSize="9" FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding PcAccount.ProviderLabel}" Style="{StaticResource CaptionTiny}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding PcAccount.StatusText}" Style="{StaticResource CaptionTiny}"
                               TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
