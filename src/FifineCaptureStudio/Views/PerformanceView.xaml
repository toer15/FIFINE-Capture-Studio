<UserControl x:Class="FifineCaptureStudio.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FifineCaptureStudio.Controls">

    <UserControl.Resources>
        <Style x:Key="MetricName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#FF7D899E" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="MetricBig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFF3F5FA" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#FF8D98AC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.8" />
            <Setter Property="Foreground" Value="#FFE7ECF5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Performance Monitor" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                <TextBlock Text="Live performance" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource MetricName}" />
                            <TextBlock Text="{Binding CpuPercentText}" Style="{StaticResource MetricBig}" />
                            <controls:Sparkline Height="34" Values="{Binding CpuHistory}" Stroke="{StaticResource Accent}" MaxValue="100" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding CpuName}" Style="{StaticResource CaptionTiny}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="GPU" Style="{StaticResource MetricName}" />
                            <TextBlock Text="{Binding GpuPercentText}" Style="{StaticResource MetricBig}" />
                            <controls:Sparkline Height="34" Values="{Binding GpuHistory}" Stroke="{StaticResource Cyan}" MaxValue="100" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding GpuName}" Style="{StaticResource CaptionTiny}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="RAM" Style="{StaticResource MetricName}" />
                            <TextBlock Text="{Binding RamPercentText}" Style="{StaticResource MetricBig}" />
                            <controls:Sparkline Height="34" Values="{Binding RamHistory}" Stroke="{StaticResource Amber}" MaxValue="100" Margin="0,6,0,0"
                                               Visibility="{Binding RamHistory, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding RamText}" Style="{StaticResource CaptionTiny}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Capture FPS" Style="{StaticResource MetricName}" />
                            <TextBlock Text="{Binding FpsText}" Style="{StaticResource MetricBig}" />
                            <controls:Sparkline Height="34" Values="{Binding FpsHistory}" Stroke="{StaticResource Green}" MaxValue="120" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding DroppedFramesText}" Style="{StaticResource CaptionTiny}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Frame pacing and latency history" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding PollRateText, StringFormat=sampled every {0}}" Style="{StaticResource CaptionTiny}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Height="128" Margin="0,12,0,0">
                            <controls:Sparkline Values="{Binding FpsHistory}" Stroke="{StaticResource Green}" MaxValue="120" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Rectangle Width="12" Height="3" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                            <TextBlock Text="frames per second" Style="{StaticResource CaptionTiny}" Margin="6,0,18,0" />
                            <Rectangle Width="12" Height="3" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="preview latency (ms)" Style="{StaticResource CaptionTiny}" Margin="6,0,18,0" />
                            <Rectangle Width="12" Height="3" Fill="{StaticResource Cyan}" VerticalAlignment="Center" />
                            <TextBlock Text="GPU utilisation (%)" Style="{StaticResource CaptionTiny}" Margin="6,0,0,0" />
                        </StackPanel>
                        <Grid Height="76" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <controls:Sparkline Grid.Row="0" Values="{Binding LatencyHistory}" Stroke="{StaticResource Accent}" />
                            <controls:Sparkline Grid.Row="1" Values="{Binding GpuHistory}" Stroke="{StaticResource Cyan}" MaxValue="100" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Capture pipeline" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Measured capture FPS" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding FpsText}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Recording FPS" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding RecordingFpsText}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Frame time" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding FrameTimeMs, StringFormat={}{0:0.0} ms}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Frame-time stability" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding JitterMs, StringFormat=±{0:0.0} ms}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="JPEG decode" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding DecodeMs, StringFormat={}{0:0.0} ms}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Preview latency (measured)" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding LatencyText}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Capture latency (estimated)" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding EstimatedCaptureLatencyText}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Audio / video offset" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding AudioOffsetLabel}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <TextBlock Text="{Binding CaptureLatencyNote}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Encoder and output" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Encoder" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding RecordingEncoderText}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Output bitrate" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding RecordingBitrateText}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="GPU encode utilisation" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding EncoderUtilizationText}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Dropped frames" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding DroppedFramesText}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="System grade" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding SystemWarning}" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Memory" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding RamText}" Style="{StaticResource RowValue}" />
                            </Grid>

                            <Border Style="{StaticResource InnerPanel}" Padding="11,9" Margin="0,12,0,0"
                                    Visibility="{Binding SystemWarningVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SystemWarning}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="GPU utilisation is read from the Windows GPU Engine performance counters. Values can be unavailable on some drivers and are then shown as n/a instead of a guess."
                                       Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
