<UserControl x:Class="FifineCaptureStudio.Views.SettingsUpdates"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <!-- UPDATE STATUS -->
        <Border Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
                <TextBlock Text="Software updates" Style="{StaticResource H2}" Margin="0,0,0,4" />
                <TextBlock Text="FIFINE Capture Studio updates itself from GitHub Releases using Velopack signed packages."
                           Style="{StaticResource CaptionTiny}" Margin="0,0,0,14" />

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{Binding UpdateStatusColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateStatusText}" Foreground="{Binding UpdateStatusColor}" FontSize="13.5"
                                   FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InstalledVersion, Mode=OneWay, StringFormat=Installed {0}}" Style="{StaticResource CaptionTiny}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Background="#3310B981" CornerRadius="6" Padding="7,3">
                            <TextBlock Text="{Binding SelectedUpdateChannel, StringFormat={}{0} channel}" Foreground="#FF7CF0BE"
                                       FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />

                <!-- download progress -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                    <Grid Height="8" x:Name="ProgressTrack">
                        <Border Background="#FF1B2436" CornerRadius="4" />
                        <Border Background="#FF8B7BFF" CornerRadius="4" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidth}">
                                    <Binding Path="UpdateProgress" />
                                    <Binding Path="ActualWidth" ElementName="ProgressTrack" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="{Binding UpdateProgressText}" Style="{StaticResource CaptionTiny}" />
                        <TextBlock Text="{Binding DownloadSpeedText}" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DownloadSizeText}" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource AccentButton}" Height="34" Width="170" Content="Check for updates"
                            Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding IsUpdateBusy, Converter={StaticResource InverseBool}}" />
                    <Button Style="{StaticResource GhostButton}" Height="34" Width="160" Margin="8,0,0,0" Content="Download update"
                            Command="{Binding DownloadUpdateCommand}"
                            Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource GhostButton}" Height="34" Width="190" Margin="8,0,0,0" Content="Install and restart"
                            Command="{Binding InstallUpdateCommand}"
                            Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource GhostButton}" Height="34" Width="140" Margin="8,0,0,0" Content="Release notes"
                            Command="{Binding ToggleReleaseNotesCommand}"
                            Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <Border Style="{StaticResource InnerPanel}" Padding="12,10" Margin="0,12,0,0"
                        Visibility="{Binding ShowReleaseNotes, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ReleaseNotes}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- AUTOMATIC UPDATES -->
        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Automatic updates" Style="{StaticResource H2}" Margin="0,0,0,12" />

                <Grid Style="{StaticResource SettingRow}">
                    <TextBlock Text="Check for updates automatically" Style="{StaticResource SettingLabel}" />
                    <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoUpdateCheck, Mode=TwoWay}" />
                </Grid>
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Background check interval" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="32" ItemsSource="{Binding UpdateIntervalLabels}"
                              SelectedItem="{Binding SelectedUpdateIntervalLabel, Mode=TwoWay}" />
                </Grid>
                <Grid Style="{StaticResource SettingRow}">
                    <TextBlock Text="Download updates automatically" Style="{StaticResource SettingLabel}" />
                    <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoDownloadUpdates, Mode=TwoWay}" />
                </Grid>
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Update channel" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="32" ItemsSource="{Binding UpdateChannels}"
                              SelectedItem="{Binding SelectedUpdateChannel, Mode=TwoWay}" />
                </Grid>
                <TextBlock Text="{Binding UpdateChannelNote}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="Installing a downloaded update restarts the app. FIFINE Capture Studio refuses to restart while a recording is running, so gameplay is never cut off."
                           Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- ABOUT -->
        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="About" Style="{StaticResource H2}" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="14" Background="#FF151B2B" BorderBrush="#FF8B7BFF" BorderThickness="1.2"
                            VerticalAlignment="Top">
                        <TextBlock Text="F" FontSize="26" FontWeight="Bold" Foreground="#FFD9D2FF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="FIFINE Capture Studio" Foreground="#FFEDF1F9" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding InstalledVersion, Mode=OneWay, StringFormat=Version {0}}"
                                   Style="{StaticResource CaptionTiny}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding BuildNumber, Mode=OneWay, StringFormat=Build {0}}" Style="{StaticResource CaptionTiny}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding UpdateRepositoryLabel, Mode=OneWay}" Style="{StaticResource CaptionTiny}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LastCheckText, Mode=OneWay}" Style="{StaticResource CaptionTiny}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource GhostButton}" Height="32" Width="190" Content="Open GitHub repository"
                            Command="{Binding OpenUpdateRepositoryCommand}" />
                    <Button Style="{StaticResource GhostButton}" Height="32" Width="150" Margin="8,0,0,0" Content="Check for updates"
                            Command="{Binding CheckUpdatesCommand}" />
                </StackPanel>
                <TextBlock Text="Updates are delivered over HTTPS from GitHub Releases. Velopack verifies each package against the SHA-256 recorded in the release feed before anything is installed, and the app never stores a GitHub token."
                           Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
