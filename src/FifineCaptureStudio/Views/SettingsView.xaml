<UserControl x:Class="FifineCaptureStudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FifineCaptureStudio.Views">

    <UserControl.Resources>
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFA5AFC2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="9" Padding="12,9" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF141C2B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF1D1B3B" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource H1}" />
                <TextBlock Text="Everything here is applied to the live capture engine as soon as it changes, and persisted to disk."
                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Height="34" Content="Setup wizard" Click="ReopenWizard_Click" />
                <Button Style="{StaticResource AccentButton}" Height="34" Width="126" Margin="8,0,0,0" Content="Save settings"
                        Command="{Binding SaveSettingsCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8" VerticalAlignment="Top">
                <StackPanel>
                    <ListBox ItemsSource="{Binding SettingsCategories}" SelectedItem="{Binding SettingsCategory, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CategoryItem}" />
                    <TextBlock Text="{Binding AppVersion, StringFormat=FIFINE Capture Studio {0}}" Style="{StaticResource CaptionTiny}"
                               Margin="10,12,0,4" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- GENERAL -->
                    <StackPanel Visibility="{Binding SettingsCategory, Converter={StaticResource EqualsToVis}, ConverterParameter=General}">
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <TextBlock Text="Launch FIFINE Capture Studio with Windows" Style="{StaticResource SettingLabel}" />
                                    <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  IsChecked="{Binding LaunchOnStartup, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <TextBlock Text="Show desktop notifications" Style="{StaticResource SettingLabel}" />
                                    <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <TextBlock Text="Language" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="English" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Theme" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="Midnight" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="Only the English interface and the Midnight theme ship with this build, so both are shown read-only instead of offering choices that do nothing."
                                           Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- CAPTURE -->
                    <StackPanel Visibility="{Binding SettingsCategory, Converter={StaticResource EqualsToVis}, ConverterParameter=Capture}">
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Capture" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Default capture method" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding SourceKinds}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedSourceKind, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Capture device" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding VideoDevices}"
                                              DisplayMemberPath="Name" SelectedItem="{Binding SelectedVideoDevice, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Display" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding Displays}"
                                              DisplayMemberPath="Name" SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Resolution" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding ResolutionOptions}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame rate" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding FpsOptions}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedFps, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Capture buffering" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding BufferModes}"
                                              SelectedItem="{Binding VideoBufferMode, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}" Visibility="{Binding IsCustomVideoBuffer, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Buffer size (ms)" Style="{StaticResource SettingLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkText}"
                                             Text="{Binding CustomVideoBufferMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <TextBlock Text="{Binding CaptureFormatSummary}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RECORDING -->
                    <StackPanel Visibility="{Binding SettingsCategory, Converter={StaticResource EqualsToVis}, ConverterParameter=Recording}">
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Recording" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Recording folder" Style="{StaticResource SettingLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkText}"
                                             Text="{Binding RecordingFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="34" Content="Open" Margin="8,0,0,0"
                                            Command="{Binding OpenRecordingsFolderCommand}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="File name pattern" Style="{StaticResource SettingLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkText}"
                                             Text="{Binding FilenameTemplate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Default codec" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding Codecs}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedCodec, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Container" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding Containers}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Encoder" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding EncoderOptions}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedEncoder, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Default bitrate" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding BitrateOptions}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedBitrate, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Style="{StaticResource Check}" Content="Prefer hardware encoding"
                                          IsChecked="{Binding HardwareEncoding, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- AUDIO -->
                    <StackPanel Visibility="{Binding SettingsCategory, Converter={StaticResource EqualsToVis}, ConverterParameter=Audio}">
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Audio" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding AudioChannels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Style="{StaticResource SettingRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SettingLabel}" />
                                                <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding Devices}"
                                                          DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sample rate" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding SampleRates}"
                                              SelectedItem="{Binding AudioSampleRate, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <TextBlock Text="Audio monitoring" Style="{StaticResource SettingLabel}" />
                                    <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  IsChecked="{Binding AudioMonitoringEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Audio / video offset" Style="{StaticResource SettingLabel}" />
                                    <Slider Grid.Column="1" Style="{StaticResource MixSlider}" Minimum="-500" Maximum="500" VerticalAlignment="Center"
                                            Value="{Binding AudioOffsetMs, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="{Binding AudioOffsetLabel}" Style="{StaticResource CaptionTiny}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Changing the sample rate restarts the WASAPI mixer; the capture pipeline keeps running."
                                           Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PERFORMANCE -->
                    <StackPanel Visibility="{Binding SettingsCategory, Converter={StaticResource EqualsToVis}, ConverterParameter=Performance}">
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Performance" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Low latency mode" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding LatencyModes}"
                                              SelectedItem="{Binding LatencyMode, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Video buffer" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding BufferModes}"
                                              SelectedItem="{Binding VideoBufferMode, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame synchronisation" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding SyncModes}"
                                              SelectedItem="{Binding SyncModeLabel, Mode=TwoWay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Audio buffer" Style="{StaticResource SettingLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding BufferModes}"
                                              SelectedItem="{Binding AudioBufferMode, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox Style="{StaticResource Check}" Content="Use GPU hardware encoding when available"
                                          IsChecked="{Binding HardwareEncoding, Mode=TwoWay}" Margin="0,4,0,10" />
                                <Border Style="{StaticResource InnerPanel}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LatencyExplanation}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LatencyExplanationDetail}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding PollRateText, StringFormat=Performance sampling interval: {0}}" Style="{StaticResource CaptionTiny}"
                                           Margin="0,12,0,0" />
                                <Button Style="{StaticResource GhostButton}" Height="32" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Content="Reset low latency defaults" Command="{Binding ResetLowLatencyCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SHORTCUTS -->
                    <StackPanel Visibility="{Binding SettingsCategory, Converter={StaticResource EqualsToVis}, ConverterParameter=Shortcuts}">
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Shortcuts" Style="{StaticResource H2}" Margin="0,0,0,6" />
                                <TextBlock Text="Use one modifier plus a key, for example Ctrl+F9. Global shortcuts work while a game is focused."
                                           Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Start / stop recording" Style="{StaticResource SettingLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkText}" Text="{Binding HotkeyRecord, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pause / resume recording" Style="{StaticResource SettingLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkText}" Text="{Binding HotkeyPause, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Save instant replay" Style="{StaticResource SettingLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkText}" Text="{Binding HotkeyReplay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mute microphone" Style="{StaticResource SettingLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkText}" Text="{Binding HotkeyMute, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Toggle fullscreen preview" Style="{StaticResource SettingLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkText}" Text="{Binding HotkeyPreview, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- GAMING TECHNOLOGIES -->
                    <StackPanel Visibility="{Binding SettingsCategory, Converter={StaticResource EqualsToVis}, ConverterParameter=Gaming}">
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="AMD GAMING TECHNOLOGIES" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <TextBlock Text="AMD Fluid Motion Frames (AFMF)" Style="{StaticResource SettingLabel}" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <Grid Style="{StaticResource SettingRow}">
                                    <TextBlock Text="GPU" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{Binding AmdGpuLabel}" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <TextBlock Text="Driver" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{Binding AmdDriverLabel}" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <TextBlock Text="ADLX" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{Binding AmdAdlxLabel}" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <TextBlock Text="AFMF compatibility" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{Binding AmdAfmfLabel}" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <TextBlock Text="Current AFMF status" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{Binding AmdAfmfState}" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Enable AFMF in the AMD driver" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Driver setting — applies to every compatible PC game, not to console captures."
                                                   Style="{StaticResource CaptionTiny}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  IsEnabled="{Binding AmdControllable}" IsChecked="{Binding AfmfEnabled, Mode=OneWay}"
                                                  ToolTip="{Binding AmdDetail}" />
                                </Grid>

                                <Border Style="{StaticResource InnerPanel}" Padding="11,9" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding AmdDetail}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="AFMF adds driver-generated frames to a game's presentation. It does not increase rendered FPS and does not lower controller input latency. A console capture card carries frames the console already rendered, so the PC GPU cannot apply AFMF to it."
                                           Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <Button Style="{StaticResource GhostButton}" Height="30" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Content="Re-detect AMD hardware" Command="{Binding RefreshAmdStatusCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="FRAME GENERATION" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <TextBlock Text="Recording-only motion interpolation" Style="{StaticResource CaptionTiny}" Margin="0,0,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Multiplier" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding FrameGenerationOptions}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedFrameGeneration, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Text="{Binding FrameGenerationSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding FrameGenerationLimitations}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="The next recording uses the new multiplier; the running preview does not change."
                                           Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- UPDATES -->
                    <local:SettingsUpdates Visibility="{Binding SettingsCategory, Converter={StaticResource EqualsToVis}, ConverterParameter=Updates}" />

                    <!-- ENGINE -->
                    <StackPanel Visibility="{Binding SettingsCategory, Converter={StaticResource EqualsToVis}, ConverterParameter=Engine}">
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Capture engine" Style="{StaticResource H2}" Margin="0,0,0,14" />
                                <TextBlock Text="{Binding EngineStatusText}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EnginePathText}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding EncoderDiagnostics}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource AccentButton}" Height="34" Width="150" Content="Install / repair engine"
                                            Command="{Binding InstallEngineCommand}" IsEnabled="{Binding IsInstallingEngine, Converter={StaticResource InverseBool}}" />
                                    <Button Style="{StaticResource GhostButton}" Height="34" Margin="8,0,0,0" Content="Open recordings folder"
                                            Command="{Binding OpenRecordingsFolderCommand}" />
                                </StackPanel>
                                <TextBlock Text="FFmpeg is downloaded from the official BtbN win64 GPL build and stored in %LOCALAPPDATA%\FifineCaptureStudio\ffmpeg. Nothing is installed system-wide."
                                           Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
