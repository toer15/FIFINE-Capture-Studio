<UserControl x:Class="FifineCaptureStudio.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="12" Background="#FF121A28" BorderBrush="#FF202A3E" BorderThickness="1" Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF3A4A67" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF8B7BFF" />
                                <Setter TargetName="Bg" Property="Background" Value="#FF161B33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.2" />
            <Setter Property="Foreground" Value="#FF8D98AC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.6" />
            <Setter Property="Foreground" Value="#FFE7ECF5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Recordings Library" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Height="34" Content="Open folder"
                        Command="{Binding OpenRecordingsFolderCommand}" />
                <Button Style="{StaticResource AccentButton}" Height="34" Width="110" Margin="8,0,0,0" Content="Rescan"
                        Command="{Binding RefreshLibraryCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="#FF0F1624" CornerRadius="9" BorderBrush="#FF212B3F" BorderThickness="1" Height="34" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconSearch}" Stroke="#FF7F8B9F" StrokeThickness="1.4" Width="12" Height="12"
                          Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#FFE7ECF5"
                             CaretBrush="#FFE7ECF5" VerticalContentAlignment="Center" FontSize="12"
                             Text="{Binding LibrarySearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
            <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" Width="150" Margin="8,0,0,0"
                      ItemsSource="{Binding LibraryPlatforms}" SelectedItem="{Binding LibraryPlatform, Mode=TwoWay}" />
            <ComboBox Grid.Column="2" Style="{StaticResource DarkCombo}" Height="34" Width="160" Margin="8,0,0,0"
                      ItemsSource="{Binding LibraryResolutions}" SelectedItem="{Binding LibraryResolution, Mode=TwoWay}" />
            <ComboBox Grid.Column="3" Style="{StaticResource DarkCombo}" Height="34" Width="150" Margin="8,0,0,0"
                      ItemsSource="{Binding LibrarySorts}" SelectedItem="{Binding LibrarySort, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="322" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <ListBox ItemsSource="{Binding RecordingView}" SelectedItem="{Binding SelectedRecording, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource CardItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="214">
                                    <Border Height="120" CornerRadius="11,11,0,0" Background="#FF080C15" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="6"
                                                    Background="#CC06090F" CornerRadius="5" Padding="6,2">
                                                <TextBlock Text="{Binding DurationLabel}" FontSize="10" Foreground="#FFE9EDF5" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="10,8,10,10">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFF0F3F9"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DateLabel}" Style="{StaticResource CaptionTiny}" Margin="0,3,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding ResolutionLabel}" Style="{StaticResource CaptionTiny}" />
                                            <TextBlock Text=" · " Style="{StaticResource CaptionTiny}" />
                                            <TextBlock Text="{Binding FpsLabel}" Style="{StaticResource CaptionTiny}" />
                                            <TextBlock Text=" · " Style="{StaticResource CaptionTiny}" />
                                            <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource CaptionTiny}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding LibraryEmpty, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconLibrary}" Stroke="#FF4B5568" StrokeThickness="1.4" Width="34" Height="34" Stretch="Uniform"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="No recordings yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Start a recording from the dashboard and it will appear here with real metadata."
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Details" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                    <Border Height="150" CornerRadius="10" Background="#FF080C15" ClipToBounds="True" Margin="0,0,0,12">
                        <Grid>
                            <Image Source="{Binding SelectedRecording.Thumbnail}" Stretch="Uniform" />
                            <TextBlock Text="Select a recording" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="{Binding HasSelectedRecording, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </Border>

                    <TextBox Style="{StaticResource DarkText}" Text="{Binding NewRecordingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Duration" Style="{StaticResource DetailLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedRecording.DurationLabel}" Style="{StaticResource DetailValue}" />
                        </Grid>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="28" Content="Rename" FontSize="11"
                                Command="{Binding RenameRecordingCommand}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Resolution" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding SelectedRecording.ResolutionLabel}" Style="{StaticResource DetailValue}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Frame rate" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding SelectedRecording.FpsLabel}" Style="{StaticResource DetailValue}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Codec" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding SelectedRecording.CodecLabel}" Style="{StaticResource DetailValue}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Platform" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding SelectedRecording.PlatformBadge}" Style="{StaticResource DetailValue}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Source" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding SelectedRecording.Source}" Style="{StaticResource DetailValue}" MaxWidth="160"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Margin="0,8,0,12">
                        <TextBlock Text="Size" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding SelectedRecording.SizeLabel}" Style="{StaticResource DetailValue}" />
                    </Grid>

                    <Button Style="{StaticResource AccentButton}" Height="36" Content="Play recording"
                            Command="{Binding PlayRecordingCommand}" IsEnabled="{Binding HasSelectedRecording}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Height="32" Content="Show in folder" FontSize="11"
                                Command="{Binding RevealRecordingCommand}" IsEnabled="{Binding HasSelectedRecording}" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="32" Content="Copy path" FontSize="11"
                                Command="{Binding CopyRecordingPathCommand}" IsEnabled="{Binding HasSelectedRecording}" />
                    </Grid>
                    <Button Style="{StaticResource GhostButton}" Height="32" Margin="0,8,0,0" Content="Delete recording" FontSize="11"
                            Foreground="#FFFF8FA3" Command="{Binding DeleteRecordingCommand}" IsEnabled="{Binding HasSelectedRecording}" />

                    <TextBlock Text="Metadata comes from the file itself (ffprobe) plus the sidecar written while recording. Nothing is guessed."
                               Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
