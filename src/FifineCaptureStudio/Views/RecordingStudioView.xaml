<UserControl x:Class="FifineCaptureStudio.Views.RecordingStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.8" />
            <Setter Property="Foreground" Value="#FF96A1B5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FormRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#FF7D899E" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFF1F4FA" />
        </Style>
        <Style x:Key="DurationChips" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFB7C0D2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="8" Background="#FF121A29" BorderBrush="#FF212B3F"
                                BorderThickness="1" Height="30" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF3A4A67" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF3A2F78" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF8B7BFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Recording Studio" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Height="34" Content="Open recordings folder"
                        Command="{Binding OpenRecordingsFolderCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="352" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- video -->
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                                <Path Data="{StaticResource IconCamera}" Stroke="#FF9B93FF" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" />
                                <TextBlock Text="Video and encoding" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                            </StackPanel>

                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Capture quality" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding CaptureQualityOptions}"
                                          SelectedItem="{Binding SelectedCaptureQuality, Mode=TwoWay}" ToolTip="{Binding QualityDetailText}" />
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Frame rate" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding FpsOptions}"
                                          DisplayMemberPath="Label" SelectedItem="{Binding SelectedFps, Mode=TwoWay}" />
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Video codec" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding Codecs}"
                                          DisplayMemberPath="Label" SelectedItem="{Binding SelectedCodec, Mode=TwoWay}" />
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Encoder" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding EncoderOptions}"
                                          DisplayMemberPath="Label" SelectedItem="{Binding SelectedEncoder, Mode=TwoWay}" />
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Container" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding Containers}"
                                          DisplayMemberPath="Label" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}" />
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Video quality" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding VideoQualityPresets}"
                                          SelectedItem="{Binding SelectedVideoQuality, Mode=TwoWay}" />
                            </Grid>
                            <Grid Style="{StaticResource FormRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bitrate" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="34" ItemsSource="{Binding BitrateOptions}"
                                          DisplayMemberPath="Label" SelectedItem="{Binding SelectedBitrate, Mode=TwoWay}"
                                          IsEnabled="{Binding IsCustomBitrate}" />
                            </Grid>

                            <Border Style="{StaticResource InnerPanel}" Padding="11,8" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding BitrateSummary}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding QualityPipelineNote}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding QualityUpscaleNotice}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Amber}" Margin="0,5,0,0"
                                               Visibility="{Binding HasUpscaleNotice, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <CheckBox Style="{StaticResource Check}" Content="Prefer hardware encoding (NVENC / AMF / Quick Sync when available)"
                                      IsChecked="{Binding HardwareEncoding, Mode=TwoWay}" Margin="0,12,0,0" />
                            <CheckBox Style="{StaticResource Check}" Content="Write game audio and microphone to separate tracks"
                                      IsChecked="{Binding SeparateAudioTracks, Mode=TwoWay}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- destination -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                                <Path Data="{StaticResource IconFolder}" Stroke="#FF9B93FF" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" />
                                <TextBlock Text="Destination" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="Recording folder" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource DarkText}" Text="{Binding RecordingFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="34" Content="Open" Margin="8,0,0,0"
                                        Command="{Binding OpenRecordingsFolderCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="34" Content="Default" Margin="6,0,0,0"
                                        Command="{Binding ResetFolderCommand}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="File name pattern" Style="{StaticResource FormLabel}" />
                                <TextBox Grid.Column="1" Style="{StaticResource DarkText}"
                                         Text="{Binding FilenameTemplate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                            <TextBlock Text="Placeholders: {platform} {date} {time}. Files are never overwritten — duplicates get a numeric suffix."
                                       Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- replay -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClock}" Stroke="#FF9B93FF" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" />
                                    <TextBlock Text="Instant replay" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding ReplayEnabled, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Text="The rolling buffer encodes in the background and keeps only the last few seconds, so saving a clip never touches footage older than the selected window."
                                       Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding ReplayDurations}" SelectedItem="{Binding SelectedReplayDuration, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Margin="0,12,0,0" DisplayMemberPath="Label"
                                     ItemContainerStyle="{StaticResource DurationChips}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <Button Style="{StaticResource GhostButton}" Height="34" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Content="Save replay now" Command="{Binding SaveReplayCommand}" />
                            <TextBlock Text="{Binding ReplaySaveState}" Style="{StaticResource CaptionTiny}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- status rail -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="16,15">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRecord}" Stroke="{StaticResource Rec}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" />
                                    <TextBlock Text="Recording" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" CornerRadius="7" Padding="8,3" Background="#FF1C1119" BorderBrush="#FF3A1B26" BorderThickness="1">
                                    <TextBlock Text="{Binding CaptureStateText}" FontSize="10.5" Foreground="#FFFF93A6" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding RecordingTimeText}" FontFamily="{StaticResource DisplayFont}" FontSize="38"
                                       FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,2" />
                            <TextBlock Text="{Binding RecordingEncoderText}" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Center" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="File size" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding RecordingSizeText}" Style="{StaticResource MetricValue}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Encoder FPS" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding RecordingFpsText}" Style="{StaticResource MetricValue}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Bitrate" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding RecordingBitrateText}" Style="{StaticResource MetricValue}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Dropped frames" Style="{StaticResource MetricLabel}" />
                                    <TextBlock Text="{Binding DroppedFramesText}" Style="{StaticResource MetricValue}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Button Style="{StaticResource RecordButton}" Height="44" Margin="0,16,0,0" Command="{Binding ToggleRecordingCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="White" VerticalAlignment="Center"
                                             Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVis}}" />
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Start recording" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Text" Value="Stop recording" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}" Height="34" Margin="0,8,0,0" Command="{Binding PauseResumeCommand}"
                                    IsEnabled="{Binding IsRecording}">
                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Pause recording" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Text" Value="Resume recording" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <TextBlock Text="{Binding RecordingSummary}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Verified encoders" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding EncoderDiagnostics}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,6,0,10" />
                            <ItemsControl ItemsSource="{Binding AvailableEncoders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF7E8AA0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Hardware}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource Green}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Vendor}" Style="{StaticResource CaptionTiny}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTiny}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
