<UserControl x:Class="FifineCaptureStudio.Views.LiveCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FifineCaptureStudio.Controls">

    <UserControl.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#FF8D98AC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.8" />
            <Setter Property="Foreground" Value="#FFE3E8F2" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#C7080C15" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Live Capture" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Minimal preview" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MinimalPreview, Mode=TwoWay}" VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}" Height="34" Margin="14,0,0,0"
                        Command="{Binding OpenEnhancementPageCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSparkle}" Stroke="#FF8FE9FF" StrokeThickness="1.5" Width="13" Height="13"
                              Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EnhancementBadgeText}" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding EnhancementEnabled, Mode=TwoWay}"
                              Margin="12,0,0,0" VerticalAlignment="Center"
                              Visibility="{Binding EnhancementAvailable, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource GhostButton}" Height="34" Margin="10,0,0,0" Content="Quick panel"
                        Command="{Binding ToggleQuickPanelCommand}"
                        Visibility="{Binding EnhancementAvailable, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource GhostButton}" Height="34" Margin="10,0,0,0" Content="Fullscreen preview"
                        Command="{Binding ToggleFullscreenCommand}" />
                <Button Style="{StaticResource AccentButton}" Height="34" Margin="8,0,0,0" Width="130"
                        Content="Start capture" Command="{Binding StartCaptureCommand}"
                        Visibility="{Binding IsPreviewing, Converter={StaticResource InverseBoolToVis}}" />
                <Button Style="{StaticResource GhostButton}" Height="34" Margin="8,0,0,0" Width="130"
                        Content="Stop capture" Command="{Binding StopCaptureCommand}"
                        Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <!-- capture quality toolbar -->
        <Border Grid.Row="2" Background="#FF0F1523" CornerRadius="12" BorderBrush="#FF1E2740" BorderThickness="1" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Capture Quality" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Style="{StaticResource DarkCombo}" Height="30" Width="190" ItemsSource="{Binding CaptureQualityOptions}"
                              SelectedItem="{Binding SelectedCaptureQuality, Mode=TwoWay}" ToolTip="{Binding QualityDetailText}" />
                    <TextBlock Text="FPS" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox Style="{StaticResource DarkCombo}" Height="30" Width="96" ItemsSource="{Binding FpsOptions}"
                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedFps, Mode=TwoWay}" />
                    <TextBlock Text="Video Quality" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox Style="{StaticResource DarkCombo}" Height="30" Width="118" ItemsSource="{Binding VideoQualityPresets}"
                              SelectedItem="{Binding SelectedVideoQuality, Mode=TwoWay}" />
                    <TextBlock Text="{Binding QualityDetailText}" Style="{StaticResource CaptionTiny}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding QualityUpscaleNotice}" Style="{StaticResource CaptionTiny}" Foreground="{StaticResource Amber}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="420" TextWrapping="Wrap"
                           Visibility="{Binding HasUpscaleNotice, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="326" />
            </Grid.ColumnDefinitions>

            <!-- preview -->
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid x:Name="PreviewSurface" MouseEnter="PreviewSurface_MouseEnter" MouseLeave="PreviewSurface_MouseLeave">
                    <!-- compact enhancement panel for use while playing -->
                    <Border Panel.ZIndex="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="300"
                            Margin="0,0,16,16" Background="#F20A101C" BorderBrush="#FF2C3A5A" BorderThickness="1"
                            CornerRadius="12" Padding="14,12"
                            Visibility="{Binding QuickPanelOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSparkle}" Stroke="#FF8FE9FF" StrokeThickness="1.5"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Gaming Enhancement" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text}" Margin="7,0,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}" Width="22" Height="22" HorizontalAlignment="Right"
                                        Command="{Binding ToggleQuickPanelCommand}" ToolTip="Close">
                                    <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="#FF98A3B6" StrokeThickness="1.4"
                                          Width="10" Height="10" Stretch="Uniform" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding EnhancementBadgeText}" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,8" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sharpening" FontSize="11" Foreground="#FFB9C3D6" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Style="{StaticResource MixSlider}" Minimum="0" Maximum="1"
                                        Value="{Binding EnhancementSharpening, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Contrast" FontSize="11" Foreground="#FFB9C3D6" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Style="{StaticResource MixSlider}" Minimum="-1" Maximum="1"
                                        Value="{Binding EnhancementContrast, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vibrance" FontSize="11" Foreground="#FFB9C3D6" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Style="{StaticResource MixSlider}" Minimum="-1" Maximum="1"
                                        Value="{Binding EnhancementVibrance, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="Comparison" FontSize="11" Foreground="#FFB9C3D6" VerticalAlignment="Center" />
                                <Button Style="{StaticResource GhostButton}" Height="26" HorizontalAlignment="Right"
                                        Content="Open full controls" Command="{Binding OpenEnhancementPageCommand}" />
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Height="28" Margin="0,8,0,0" Content="Disable all enhancement"
                                    Command="{Binding DisableEnhancementCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FF04060A" CornerRadius="14" ClipToBounds="True">
                        <Grid>
                            <!-- single enhanced view -->
                            <Image x:Name="PreviewImageElement" Source="{Binding PreviewImage}"
                                   Stretch="{Binding KeepAspect, Converter={StaticResource BoolToStretch}}"
                                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding IsComparisonSingle, Converter={StaticResource BoolToVis}}" />

                            <!-- split: original frame, enhanced right half overlay -->
                            <Grid Visibility="{Binding IsComparisonSplit, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding OriginalPreviewImage}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border HorizontalAlignment="Right" ClipToBounds="True"
                                        Width="{Binding ActualWidth, ElementName=PreviewSurface, Converter={StaticResource HalfValue}}">
                                    <Image Source="{Binding PreviewImage}" HorizontalAlignment="Right"
                                           Width="{Binding ActualWidth, ElementName=PreviewSurface}"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <Rectangle Width="2" Fill="#FF8FE9FF" HorizontalAlignment="Center" />
                            </Grid>

                            <!-- side by side: untouched left, enhanced right -->
                            <Grid Visibility="{Binding IsComparisonSideBySide, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding OriginalPreviewImage}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Rectangle Grid.Column="1" Fill="#FF8FE9FF" />
                                <Image Grid.Column="2" Source="{Binding PreviewImage}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Opacity="0" IsHitTestVisible="False"
                                Command="{Binding ToggleFullscreenCommand}" ToolTip="Enter Fullscreen"
                                RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="FullscreenScale" ScaleX="0.82" ScaleY="0.82" />
                            </Button.RenderTransform>
                            <Path Data="{StaticResource IconExpand}" Stroke="#FFD6DEEE" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </StackPanel>

                    <Border Background="#F0070A12" CornerRadius="14"
                            Visibility="{Binding ShowNoSignal, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                            <TextBlock Text="No capture signal" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CaptureFormatSummary}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,10,0,0" />
                            <Button Style="{StaticResource AccentButton}" Height="38" Width="160" Content="Start capture"
                                    Command="{Binding StartCaptureCommand}" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Bottom" Height="44" Background="#D9080B14" CornerRadius="0,0,14,14">
                        <Grid Margin="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Preview scale" Style="{StaticResource Caption}" />
                                <ComboBox Style="{StaticResource DarkCombo}" Height="25" Width="84" Margin="8,0,0,0"
                                          ItemsSource="{Binding PreviewScales}" SelectedItem="{Binding PreviewScaleLabel, Mode=TwoWay}" />
                                <TextBlock Text="Keep aspect" Style="{StaticResource Caption}" Margin="16,0,8,0" />
                                <ToggleButton Style="{StaticResource Switch}" Width="34" Height="19" IsChecked="{Binding KeepAspect, Mode=TwoWay}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CaptureStateText}" Style="{StaticResource Caption}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- right rail -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding MinimalPreview, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Path Data="{StaticResource IconMonitor}" Stroke="#FF9B93FF" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" />
                                <TextBlock Text="Signal information" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                            </StackPanel>

                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Source" Style="{StaticResource InfoLabel}" />
                                <TextBlock Text="{Binding DeviceCardTitle}" Style="{StaticResource InfoValue}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Capture method" Style="{StaticResource InfoLabel}" />
                                <TextBlock Text="{Binding SelectedSourceKind.Label}" Style="{StaticResource InfoValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Input" Style="{StaticResource InfoLabel}" />
                                <TextBlock Style="{StaticResource InfoValue}">
                                    <Run Text="{Binding InputResolutionLabel, Mode=OneWay}" /><Run Text=" @ " /><Run Text="{Binding FpsChipLabel, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Measured FPS" Style="{StaticResource InfoLabel}" />
                                <TextBlock Text="{Binding FpsText}" Style="{StaticResource InfoValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Frame time / jitter" Style="{StaticResource InfoLabel}" />
                                <TextBlock Text="{Binding FrameTimeMs, StringFormat={}{0:0.0} ms}" Style="{StaticResource InfoValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="JPEG decode" Style="{StaticResource InfoLabel}" />
                                <TextBlock Text="{Binding DecodeMs, StringFormat={}{0:0.0} ms}" Style="{StaticResource InfoValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Preview latency" Style="{StaticResource InfoLabel}" />
                                <TextBlock Text="{Binding LatencyText}" Style="{StaticResource InfoValue}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="Capture latency (est.)" Style="{StaticResource InfoLabel}" />
                                <TextBlock Text="{Binding EstimatedCaptureLatencyText}" Style="{StaticResource InfoValue}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Dropped / gaps" Style="{StaticResource InfoLabel}" />
                                <TextBlock Text="{Binding DroppedFramesText}" Style="{StaticResource InfoValue}" />
                            </Grid>

                            <TextBlock Text="Preview latency is measured from decoded frame to screen; capture latency is an estimate derived from buffering."
                                       Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14,13" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Audio monitoring" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />

                            <TextBlock Text="Monitor output" Style="{StaticResource CaptionTiny}" Margin="0,0,0,4" />
                            <ComboBox Style="{StaticResource DarkCombo}" Height="28" ItemsSource="{Binding MonitoringOutputs}"
                                      DisplayMemberPath="Name" SelectedItem="{Binding SelectedMonitoringOutput, Mode=TwoWay}"
                                      ToolTip="{Binding AudioLatencyLabel}" />

                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource Switch}" Width="30" Height="17" VerticalAlignment="Center"
                                                  ToolTip="Hear the microphone in the monitor output"
                                                  IsChecked="{Binding MicMonitorEnabled, Mode=TwoWay}" />
                                    <TextBlock Text="MIC" Style="{StaticResource CaptionTiny}" VerticalAlignment="Center" Margin="7,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource Switch}" Width="30" Height="17" VerticalAlignment="Center"
                                                  ToolTip="Hear game audio in the monitor output"
                                                  IsChecked="{Binding GameMonitorEnabled, Mode=TwoWay}" />
                                    <TextBlock Text="GAME" Style="{StaticResource CaptionTiny}" VerticalAlignment="Center" Margin="7,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource Switch}" Width="30" Height="17" VerticalAlignment="Center"
                                                  ToolTip="Hear capture card audio in the monitor output"
                                                  IsChecked="{Binding CaptureMonitorEnabled, Mode=TwoWay}" />
                                    <TextBlock Text="CARD" Style="{StaticResource CaptionTiny}" VerticalAlignment="Center" Margin="7,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding AudioChannels}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="12" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Slider Grid.Column="1" Style="{StaticResource MixSlider}" Minimum="0" Maximum="1"
                                                    Value="{Binding Volume, Mode=OneWay}" VerticalAlignment="Center" Margin="4,0,8,0"
                                                    Thumb.DragCompleted="VolumeCommit" PreviewMouseLeftButtonUp="VolumeCommit" PreviewKeyUp="VolumeCommit" />
                                            <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0}%}" Style="{StaticResource CaptionTiny}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <controls:LevelMeter Grid.Column="3" Width="7" Height="16" Level="{Binding Level}" Margin="4,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource GhostButton}" Height="28" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Content="Open audio studio" FontSize="11" Command="{Binding NavigateCommand}" CommandParameter="audio" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14,13" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Quick actions" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <Button Style="{StaticResource RecordButton}" Height="40" Command="{Binding ToggleRecordingCommand}">
                                <TextBlock Text="Start recording" FontSize="12.5" FontWeight="SemiBold"
                                           Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVis}}" />
                            </Button>
                            <Button Style="{StaticResource RecordButton}" Height="40" Command="{Binding ToggleRecordingCommand}"
                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Stop recording" FontSize="12.5" FontWeight="SemiBold" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Height="34" Margin="0,8,0,0"
                                    Content="Save instant replay" Command="{Binding SaveReplayCommand}" />
                            <TextBlock Text="{Binding ReplaySummary}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
