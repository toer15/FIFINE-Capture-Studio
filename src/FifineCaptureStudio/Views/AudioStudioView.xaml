<UserControl x:Class="FifineCaptureStudio.Views.AudioStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FifineCaptureStudio.Controls">

    <UserControl.Resources>
        <Style x:Key="ChannelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF8D98AC" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Audio Studio" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding AudioEngineState}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Monitor mix" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AudioMonitoringEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}" Height="34" Margin="14,0,0,0" Content="Restart audio engine"
                        Command="{Binding RestartAudioCommand}" />
                <Button Style="{StaticResource AccentButton}" Height="34" Margin="8,0,0,0" Width="126" Content="Save settings"
                        Command="{Binding SaveSettingsCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AudioChannels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" CornerRadius="9" Background="#FF1A2233">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                           Foreground="#FFB2A8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#FF6B7688" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource Green}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTiny}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Click="Mute_Click" ToolTip="Mute this channel">
                                                <TextBlock Text="{Binding MuteGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#FFC3CCDB" />
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Monitor" Style="{StaticResource CaptionTiny}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ToggleButton Style="{StaticResource Switch}" Width="34" Height="19"
                                                              IsChecked="{Binding Monitor, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Style="{StaticResource DarkCombo}" Height="32" ItemsSource="{Binding Devices}"
                                                  DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormatLabel}" Style="{StaticResource CaptionTiny}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Style="{StaticResource MixSlider}" Minimum="0" Maximum="1.5" VerticalAlignment="Center"
                                                Value="{Binding Volume, Mode=OneWay}"
                                                Thumb.DragCompleted="VolumeCommit" PreviewMouseLeftButtonUp="VolumeCommit" PreviewKeyUp="VolumeCommit" />
                                        <TextBlock Grid.Column="1" Text="{Binding VolumePercent, StringFormat={}{0}%}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <controls:LevelMeter Grid.Column="3" Height="8" Level="{Binding Level}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding LevelDecibels}" Style="{StaticResource CaptionTiny}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="Delay" Style="{StaticResource ChannelLabel}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="44,0,0,0">
                                            <TextBox Style="{StaticResource DarkText}" Width="70" Height="28" TextAlignment="Center"
                                                     Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="ms" Style="{StaticResource CaptionTiny}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <TextBlock Text="Aligns late sources with the video by delaying the audio path."
                                                       Style="{StaticResource CaptionTiny}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Mix output" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />

                            <TextBlock Text="LIVE AUDIO MONITORING" Style="{StaticResource ChannelLabel}" Foreground="#FF9B8BFF" FontWeight="SemiBold" />
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Hear the mix in real time" Style="{StaticResource CaptionTiny}" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" Width="34" Height="19"
                                              HorizontalAlignment="Right" IsChecked="{Binding AudioMonitoringEnabled, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock Text="Monitoring output device" Style="{StaticResource ChannelLabel}" />
                            <ComboBox Style="{StaticResource DarkCombo}" Height="32" Margin="0,0,0,6" ItemsSource="{Binding MonitoringOutputs}"
                                      DisplayMemberPath="Name" SelectedItem="{Binding SelectedMonitoringOutput, Mode=TwoWay}" />
                            <TextBlock Text="{Binding AudioLatencyLabel}" Style="{StaticResource CaptionTiny}" Margin="0,0,0,10" />

                            <TextBlock Text="Monitor these sources" Style="{StaticResource ChannelLabel}" />
                            <StackPanel Margin="0,2,0,6">
                                <Grid Height="26">
                                    <TextBlock Text="Microphone" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource Switch}" Width="34" Height="19" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding MicMonitorEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Grid Height="26">
                                    <TextBlock Text="Game audio" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource Switch}" Width="34" Height="19" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding GameMonitorEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Grid Height="26">
                                    <TextBlock Text="Capture card audio" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <ToggleButton Style="{StaticResource Switch}" Width="34" Height="19" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" IsChecked="{Binding CaptureMonitorEnabled, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{Binding MonitoringRouteNote}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="Monitoring level" Style="{StaticResource ChannelLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Slider Style="{StaticResource MixSlider}" Minimum="0" Maximum="1.5" VerticalAlignment="Center"
                                        Value="{Binding MonitoringVolume, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding MonitoringVolume, StringFormat={}{0:P0}}" Style="{StaticResource CaptionTiny}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="Audio / video offset" Style="{StaticResource ChannelLabel}" Margin="0,14,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Slider Style="{StaticResource MixSlider}" Minimum="-500" Maximum="500" SmallChange="10" LargeChange="50"
                                        VerticalAlignment="Center" Value="{Binding AudioOffsetMs, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding AudioOffsetLabel}" Style="{StaticResource CaptionTiny}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <CheckBox Style="{StaticResource Check}" Content="Write separate game and microphone tracks"
                                      IsChecked="{Binding SeparateAudioTracks, Mode=TwoWay}" Margin="0,16,0,0" />

                            <TextBlock Text="Audio is captured through WASAPI in shared mode at the device's own mix format, resampled to 48 kHz stereo, and muxed with the video by the recording engine."
                                       Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding SeparateTracksNote}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Buffer and sync" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Audio buffer" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AudioBufferMode}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Video buffer" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding VideoBufferLabel}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Sync mode" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SyncModeLabel}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Height="30" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Content="Change in settings" FontSize="11" Command="{Binding NavigateCommand}" CommandParameter="settings" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Microphone mute" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding MicMuteLabel}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" />
                            <Button Style="{StaticResource GhostButton}" Height="32" Margin="0,12,0,0" Content="Toggle microphone mute"
                                    Command="{Binding ToggleMuteMicCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
