<UserControl x:Class="FifineCaptureStudio.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FifineCaptureStudio.Controls"
             xmlns:vm="clr-namespace:FifineCaptureStudio.ViewModels"
             d:DesignHeight="860" d:DesignWidth="1360"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SectionIcon" TargetType="Path">
            <Setter Property="Stroke" Value="#FF9B93FF" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.8" />
            <Setter Property="Foreground" Value="#FFA4AFC2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OverlayChip" TargetType="Border">
            <Setter Property="Background" Value="#C7080C15" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DurationChipItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFB7C0D2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="8" Background="#FF121A29" BorderBrush="#FF212B3F" BorderThickness="1"
                                Height="28" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF3A4A67" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF3A2F78" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF8B7BFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlatformChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="9" Background="#FF0F1624" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource LineBright}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentGradient}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFB3AAFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <!-- ======================= LEFT: PREVIEW ======================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="216" />
            </Grid.RowDefinitions>

            <!-- Platform tabs -->
            <Grid Grid.Row="0" Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton Grid.Column="0" Style="{StaticResource PlatformTab}" GroupName="Platform"
                             IsChecked="{Binding IsPlatformPC, Mode=OneWay}"
                             Command="{Binding SelectPlatformCommand}" CommandParameter="PC">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconMonitor}" Style="{StaticResource SectionIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" />
                        <TextBlock Text="PC Gaming" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Grid.Column="1" Style="{StaticResource PlatformTab}" GroupName="Platform"
                             IsChecked="{Binding IsPlatformPS5, Mode=OneWay}"
                             Command="{Binding SelectPlatformCommand}" CommandParameter="PS5">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M9.6,4.2 C15.3,5.1 19.2,7.9 19.2,12.1 V19.6 H15.9 V13.1 C15.9,10.9 14.1,9.3 11.1,8.8 Z M5.2,5 L8.4,5.6 V17.3 L11.4,16.4 V20 L5.2,21 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" Stretch="Uniform" />
                        <TextBlock Text="PlayStation 5" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Grid.Column="2" Style="{StaticResource PlatformTab}" GroupName="Platform"
                             IsChecked="{Binding IsPlatformXbox, Mode=OneWay}"
                             Command="{Binding SelectPlatformCommand}" CommandParameter="Xbox">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconXbox}" Style="{StaticResource SectionIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="18" Height="18" />
                        <TextBlock Text="Xbox" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!-- Preview -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid x:Name="PreviewSurface" MouseEnter="PreviewSurface_MouseEnter" MouseLeave="PreviewSurface_MouseLeave">
                    <!-- quick enhancement control -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                            Background="#CC080C15" BorderBrush="#443B4A6A" BorderThickness="1" CornerRadius="8" Padding="9,5"
                            Visibility="{Binding EnhancementAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSparkle}" Stroke="#FF8FE9FF" StrokeThickness="1.5" Width="12" Height="12"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EnhancementBadgeText}" FontSize="10.5" Foreground="#FFDCE5F2"
                                       Margin="6,0,8,0" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding EnhancementEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButton}" Width="22" Height="22" Margin="6,0,0,0"
                                    Command="{Binding OpenEnhancementPageCommand}" ToolTip="Open gaming enhancement">
                                <Path Data="{StaticResource IconChevron}" Stroke="#FF9BB0C9" StrokeThickness="1.4" Width="9" Height="9"
                                      Stretch="Uniform">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </StackPanel>
                    </Border>
                    <controls:FpsOverlayView Panel.ZIndex="20" />

                    <Border Background="#FF04060A" CornerRadius="14">
                        <Image x:Name="PreviewImageElement" Source="{Binding PreviewImage}"
                               Stretch="{Binding KeepAspect, Converter={StaticResource BoolToStretch}}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5,0.5" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Opacity="0" IsHitTestVisible="False"
                                Command="{Binding ToggleFullscreenCommand}" ToolTip="Enter Fullscreen"
                                RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="FullscreenScale" ScaleX="0.82" ScaleY="0.82" />
                            </Button.RenderTransform>
                            <Path Data="{StaticResource IconExpand}" Stroke="#FFD6DEEE" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </StackPanel>

                    <!-- no signal -->
                    <Border Background="#F0070A12" CornerRadius="14"
                            Visibility="{Binding ShowNoSignal, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                            <Border Width="52" Height="52" CornerRadius="16" Background="#FF161F31" BorderBrush="#FF2A3A55" BorderThickness="1" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconCamera}" Stroke="#FF8F84FF" StrokeThickness="1.5"
                                      Width="22" Height="22" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Waiting for a capture signal" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding DeviceCardSubtitle}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding CaptureFormatSummary}" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button Style="{StaticResource AccentButton}" Height="38" Content="Start capture"
                                        Command="{Binding StartCaptureCommand}" />
                                <Button Style="{StaticResource GhostButton}" Height="38" Content="Capture sources" Margin="8,0,0,0"
                                        Command="{Binding NavigateCommand}" CommandParameter="sources" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- preview footer -->
                    <Border VerticalAlignment="Bottom" Height="42" Background="#D9080B14" CornerRadius="0,0,14,14">
                        <Grid Margin="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Preview Scale:" Style="{StaticResource Caption}" />
                                <ComboBox Style="{StaticResource DarkCombo}" Height="26" Width="86" Margin="8,0,0,0"
                                          ItemsSource="{Binding PreviewScales}" SelectedItem="{Binding PreviewScaleLabel, Mode=TwoWay}" />
                                <TextBlock Text="Keep Aspect Ratio" Style="{StaticResource Caption}" Margin="16,0,0,0" />
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding KeepAspect, Mode=TwoWay}"
                                              Width="34" Height="19" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CaptureStateText}" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFullscreenCommand}" ToolTip="Fullscreen">
                                    <Path Data="{StaticResource IconExpand}" Stroke="#FFCFD7E6" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom cards -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.32*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.24*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.02*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="0.92*" />
                </Grid.ColumnDefinitions>

                <!-- Audio mixer -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="13,11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWave}" Style="{StaticResource SectionIcon}" />
                                <TextBlock Text="Audio Mixer" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding AudioStatusText}" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding AudioChannels}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AudioChannelViewModel}">
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="11" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="{Binding Glyph, Converter={StaticResource KeyToGeometry}}" Stroke="#FF8894AA"
                                              StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11.3" Foreground="#FFC6CFDF"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Slider Grid.Column="2" Style="{StaticResource MixSlider}" Minimum="0" Maximum="1"
                                                Value="{Binding Volume, Mode=OneWay}" VerticalAlignment="Center" Margin="4,0,8,0"
                                                Thumb.DragCompleted="VolumeCommit" PreviewMouseLeftButtonUp="VolumeCommit" PreviewKeyUp="VolumeCommit" />
                                        <TextBlock Grid.Column="3" Text="{Binding VolumePercent, StringFormat={}{0}%}" FontSize="10.5"
                                                   Foreground="#FF98A3B6" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <controls:LevelMeter Grid.Column="4" Width="7" Height="18" Level="{Binding Level}"
                                                             Orientation="Vertical" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Row="2" Style="{StaticResource GhostButton}" Height="28" HorizontalAlignment="Left"
                                Content="Advanced Audio" FontSize="11.5" Command="{Binding NavigateCommand}" CommandParameter="audio" />
                    </Grid>
                </Border>

                <!-- Performance -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="13,11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconChart}" Style="{StaticResource SectionIcon}" />
                                <TextBlock Text="Performance Monitor" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                                <TextBlock Text="Live" Style="{StaticResource CaptionTiny}" Margin="5,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:RingGauge Width="58" Height="58" Value="{Binding CpuPercent}" MaxValue="100"
                                                ValueText="{Binding CpuPercentText}" Caption="CPU"
                                                Accent="#FF35C9FF" Margin="0,0,6,0" />
                            <controls:RingGauge Grid.Column="1" Width="58" Height="58" Value="{Binding GpuPercent}" MaxValue="100"
                                                ValueText="{Binding GpuPercentText}" Caption="GPU"
                                                Accent="#FF8275FF" Margin="0,0,6,0" />
                            <controls:RingGauge Grid.Column="2" Width="58" Height="58" Value="{Binding RamPercent}" MaxValue="100"
                                                ValueText="{Binding RamPercentText}" Caption="RAM"
                                                Accent="#FFFFB547" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding GameFpsDisplay}" FontFamily="{StaticResource DisplayFont}" FontSize="25"
                                               FontWeight="SemiBold" Foreground="White" />
                                    <Border Background="#3324D8A0" BorderBrush="#6657F0C0" BorderThickness="1"
                                            CornerRadius="5" Padding="5,1" Margin="7,3,0,0" VerticalAlignment="Top"
                                            Visibility="{Binding FrameGenBadgeVisible, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding FrameGenMultiplierDisplay}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="#FF7CF0BE" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-4,1,0">
                                    <TextBlock Text="FPS" Style="{StaticResource CaptionTiny}" />
                                    <TextBlock Text="{Binding FrameGenOutputDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="#FF8FE9FF" Margin="7,0,0,0"
                                               Visibility="{Binding FrameGenBadgeVisible, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <StackPanel>
                                <controls:Sparkline Height="34" Values="{Binding FpsHistory}" Stroke="#FF7E8DFF" MaxValue="70" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource CaptionTiny}">
                                        <Run Text="Latency " /><Run Text="{Binding LatencyText, Mode=OneWay}" /><Run Text=" · Dropped " /><Run Text="{Binding DroppedFramesText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding RecordingBitrateText}" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Controller -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="13,11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPad}" Style="{StaticResource SectionIcon}" />
                                <TextBlock Text="Controller Input" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding PollRateText}" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <controls:ControllerPad Grid.Row="1" Margin="0,2"
                                                LeftX="{Binding StickLeftX}" LeftY="{Binding StickLeftY}"
                                                RightX="{Binding StickRightX}" RightY="{Binding StickRightY}"
                                                LeftTrigger="{Binding TriggerLeft}" RightTrigger="{Binding TriggerRight}"
                                                PressedA="{Binding ButtonA}" PressedB="{Binding ButtonB}"
                                                PressedX="{Binding ButtonX}" PressedY="{Binding ButtonY}"
                                                LeftBumper="{Binding BumperLeft}" RightBumper="{Binding BumperRight}"
                                                Connected="{Binding ControllerConnected}" />

                        <Grid Grid.Row="2">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF3A4459" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ControllerConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Green}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ControllerName}" Style="{StaticResource CaptionTiny}" Margin="6,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding StickRightReadout}" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Instant replay -->
                <Border Grid.Column="6" Style="{StaticResource Card}" Padding="13,11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClock}" Style="{StaticResource SectionIcon}" />
                                <TextBlock Text="Instant Replay" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" Width="34" Height="19" HorizontalAlignment="Right"
                                          IsChecked="{Binding ReplayEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding ReplayDurations}"
                                 SelectedItem="{Binding SelectedReplayDuration, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Margin="0,12,0,0"
                                 ItemContainerStyle="{StaticResource DurationChipItem}"
                                 DisplayMemberPath="Label"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <StackPanel Grid.Row="2">
                            <Button Style="{StaticResource AccentButton}" Height="36" Command="{Binding SaveReplayCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSave}" Stroke="White" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                                    <TextBlock Text="Save Replay" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ReplaySaveState}" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================= RIGHT RAIL ======================= -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Capture source -->
                <Border Style="{StaticResource Card}" Padding="14,13">
                    <StackPanel>
                        <Grid Margin="0,0,0,11">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCamera}" Style="{StaticResource SectionIcon}" />
                                <TextBlock Text="Capture Source" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Rectangle Width="3" Height="5" Fill="{StaticResource Green}" RadiusX="1" RadiusY="1" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                                <Rectangle Width="3" Height="8" Fill="{StaticResource Green}" RadiusX="1" RadiusY="1" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                                <Rectangle Width="3" Height="11" Fill="{StaticResource Green}" RadiusX="1" RadiusY="1" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                                <Rectangle Width="3" Height="14" Fill="#FF45D69A" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="3" Height="42" Margin="0,0,0,10">
                            <RadioButton Style="{StaticResource PlatformChip}" GroupName="RailPlatform"
                                         IsChecked="{Binding IsPlatformPS5, Mode=OneWay}"
                                         Command="{Binding SelectPlatformCommand}" CommandParameter="PS5">
                                <TextBlock Text="PS5" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource PlatformChip}" GroupName="RailPlatform"
                                         IsChecked="{Binding IsPlatformXbox, Mode=OneWay}"
                                         Command="{Binding SelectPlatformCommand}" CommandParameter="Xbox">
                                <TextBlock Text="Xbox" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource PlatformChip}" GroupName="RailPlatform" Margin="6,0,0,0"
                                         IsChecked="{Binding IsPlatformPC, Mode=OneWay}"
                                         Command="{Binding SelectPlatformCommand}" CommandParameter="PC">
                                <TextBlock Text="PC" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </RadioButton>
                        </UniformGrid>

                        <TextBlock Text="CAPTURE MODE" Style="{StaticResource CaptionTiny}" FontWeight="SemiBold" Margin="0,2,0,5" />
                        <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding CaptureModes}"
                                  DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedCaptureMode, Mode=TwoWay}" Height="35"
                                  ToolTip="{Binding CaptureModeNote}" />
                        <TextBlock Text="{Binding CaptureModeNote}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap"
                                   Margin="2,5,0,8" Foreground="#FF8E9AB2" />

                        <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding SourceKinds}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedSourceKind, Mode=TwoWay}" Height="35" />
                        <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding VideoDevices}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedVideoDevice, Mode=TwoWay}" Height="35" Margin="0,7,0,0"
                                  Visibility="{Binding IsSourceCaptureCard, Converter={StaticResource BoolToVis}}" />
                        <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Displays}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}" Height="35" Margin="0,7,0,0"
                                  Visibility="{Binding IsSourceDisplay, Converter={StaticResource BoolToVis}}" />
                        <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Windows}" DisplayMemberPath="Title"
                                  SelectedItem="{Binding SelectedWindow, Mode=TwoWay}" Height="35" Margin="0,7,0,0"
                                  Visibility="{Binding IsSourceWindow, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF445068" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Green}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DeviceConnectionText}" Style="{StaticResource Caption}" Margin="7,0,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Height="27" Content="Configure" FontSize="11"
                                    HorizontalAlignment="Right" Command="{Binding NavigateCommand}" CommandParameter="sources" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Video settings -->
                <Border Style="{StaticResource Card}" Padding="14,13" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <Path Data="{StaticResource IconMonitor}" Style="{StaticResource SectionIcon}" />
                            <TextBlock Text="Video Settings" Style="{StaticResource CardTitle}" Margin="8,0,0,0" />
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resolution:" Style="{StaticResource RailLabel}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="33"
                                      AutomationProperties.Name="Capture resolution"
                                      ItemsSource="{Binding ResolutionOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FPS:" Style="{StaticResource RailLabel}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" Height="33"
                                      AutomationProperties.Name="Capture frame rate"
                                      ItemsSource="{Binding FpsOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedFps, Mode=TwoWay}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HDR:" Style="{StaticResource RailLabel}" ToolTip="{Binding HdrHint}" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding HdrEnabled, Mode=TwoWay}" IsEnabled="{Binding IsHdrAvailable}"
                                          ToolTip="{Binding HdrHint}" />
                        </Grid>

                        <TextBlock Text="{Binding CaptureFormatSummary}" Style="{StaticResource CaptionTiny}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Low latency -->
                <Border Style="{StaticResource Card}" Padding="14,13" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="10" Background="#FF1B2440" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBolt}" Stroke="#FF8F84FF" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="Low Latency Mode" Style="{StaticResource CardTitle}" FontSize="12.5" />
                            <TextBlock Text="{Binding LowLatencyBadge}" Style="{StaticResource CaptionTiny}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding LowLatencyEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Actions -->
                <Grid Margin="0,10,0,0" Height="46">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource RecordButton}" Command="{Binding ToggleRecordingCommand}"
                            Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" Fill="White" VerticalAlignment="Center" />
                            <TextBlock Text="Start Recording" Margin="9,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="0" Style="{StaticResource RecordButton}" Command="{Binding ToggleRecordingCommand}"
                            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="11" Height="11" Fill="White" RadiusX="2" RadiusY="2" VerticalAlignment="Center" />
                            <TextBlock Text="Stop Recording" Margin="9,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="0" ToolTip="Save the last replay clip"
                            Command="{Binding SaveReplayCommand}">
                        <Path Data="{StaticResource IconClock}" Stroke="#FFD6DEEE" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </Grid>

                <Button Style="{StaticResource GhostButton}" Height="40" Margin="0,8,0,0" Command="{Binding PauseResumeCommand}"
                        Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPause}" Stroke="#FFD6DEEE" StrokeThickness="1.7" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Pause recording" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Text" Value="Resume recording" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource InnerPanel}" Padding="11,9" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconInfo}" Stroke="#FF6F7C93" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding SourceKindHint}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
