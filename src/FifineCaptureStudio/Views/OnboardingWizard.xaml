<UserControl x:Class="FifineCaptureStudio.Views.OnboardingWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FifineCaptureStudio.Views">

    <UserControl.Resources>
        <Style x:Key="WizardPlatform" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="14" Background="#FF0F1624" BorderBrush="#FF212B3F" BorderThickness="1" Padding="18" Margin="0,0,10,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF3B4A6A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF8B7BFF" />
                                <Setter TargetName="Bg" Property="Background" Value="#FF1B1B3C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WizardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#FF8D98AC" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Width="780" MaxHeight="640" CornerRadius="22" Background="{StaticResource CardGradient}"
                BorderBrush="#FF2C3555" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Opacity="0.6" ShadowDepth="10" Color="#FF000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Margin="26,22,22,0">
                    <StackPanel Orientation="Horizontal">
                        <views:BrandMark Width="30" Height="15" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding WizardTitle}" Style="{StaticResource H1}" FontSize="18" />
                            <TextBlock Text="{Binding WizardStepLabel}" Style="{StaticResource CaptionTiny}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="Skip_Click" ToolTip="Skip setup">
                        <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="#FF8A94A7" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- step indicator -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,64,0">
                    <Rectangle Width="16" Height="3" RadiusX="2" RadiusY="2" Margin="2,0" Fill="#FF8275FF" />
                    <Rectangle Width="16" Height="3" RadiusX="2" RadiusY="2" Margin="2,0" Fill="{Binding WizardStep, Converter={StaticResource StepFill}, ConverterParameter=2}" />
                    <Rectangle Width="16" Height="3" RadiusX="2" RadiusY="2" Margin="2,0" Fill="{Binding WizardStep, Converter={StaticResource StepFill}, ConverterParameter=3}" />
                    <Rectangle Width="16" Height="3" RadiusX="2" RadiusY="2" Margin="2,0" Fill="{Binding WizardStep, Converter={StaticResource StepFill}, ConverterParameter=4}" />
                    <Rectangle Width="16" Height="3" RadiusX="2" RadiusY="2" Margin="2,0" Fill="{Binding WizardStep, Converter={StaticResource StepFill}, ConverterParameter=5}" />
                    <Rectangle Width="16" Height="3" RadiusX="2" RadiusY="2" Margin="2,0" Fill="{Binding WizardStep, Converter={StaticResource StepFill}, ConverterParameter=6}" />
                    <Rectangle Width="16" Height="3" RadiusX="2" RadiusY="2" Margin="2,0" Fill="{Binding WizardStep, Converter={StaticResource StepFill}, ConverterParameter=7}" />
                </StackPanel>

                <!-- content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="26,18,20,0">
                    <Grid>
                        <!-- STEP 1 -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource EqualsToVis}, ConverterParameter=1}">
                            <TextBlock Text="Pick the machine you capture most often. Every platform can still be switched later from the dashboard."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource WizardPlatform}" GroupName="WizardPlatform"
                                             IsChecked="{Binding IsPlatformPC, Mode=OneWay}"
                                             Command="{Binding SelectPlatformCommand}" CommandParameter="PC">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconMonitor}" Stroke="#FFB2A8FF" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" />
                                        <TextBlock Text="PC Gaming" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0" />
                                        <TextBlock Text="Desktop, window or capture card" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource WizardPlatform}" GroupName="WizardPlatform"
                                             IsChecked="{Binding IsPlatformPS5, Mode=OneWay}"
                                             Command="{Binding SelectPlatformCommand}" CommandParameter="PS5">
                                    <StackPanel>
                                        <Path Data="M9.6,4.2 C15.3,5.1 19.2,7.9 19.2,12.1 V19.6 H15.9 V13.1 C15.9,10.9 14.1,9.3 11.1,8.8 Z M5.2,5 L8.4,5.6 V17.3 L11.4,16.4 V20 L5.2,21 Z"
                                              Fill="#FFB2A8FF" Width="24" Height="24" Stretch="Uniform" />
                                        <TextBlock Text="PlayStation 5" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0" />
                                        <TextBlock Text="HDMI through a capture card" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource WizardPlatform}" GroupName="WizardPlatform" Margin="0"
                                             IsChecked="{Binding IsPlatformXbox, Mode=OneWay}"
                                             Command="{Binding SelectPlatformCommand}" CommandParameter="Xbox">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconXbox}" Stroke="#FFB2A8FF" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" />
                                        <TextBlock Text="Xbox" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0" />
                                        <TextBlock Text="Series X, Series S and Xbox One" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>

                        <!-- STEP 2 -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource EqualsToVis}, ConverterParameter=2}">
                            <TextBlock Text="FIFINE Capture Studio reads the real capture filters that Windows exposes through DirectShow."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <Border Style="{StaticResource InnerPanel}" Padding="12">
                                <ItemsControl ItemsSource="{Binding VideoDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="34">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="capture card" Style="{StaticResource CaptionTiny}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsCaptureCard, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="No capture device listed?" Style="{StaticResource CaptionTiny}" Margin="0,12,0,0" />
                            <TextBlock Text="Connect the card to a USB 3 port and press rescan. Capture cards usually appear even before a console is switched on."
                                       Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Foreground="#FF6E7A90" />
                            <Button Style="{StaticResource GhostButton}" Height="34" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Content="Rescan devices" Command="{Binding RefreshDevicesCommand}" />
                        </StackPanel>

                        <!-- STEP 3 -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource EqualsToVis}, ConverterParameter=3}">
                            <TextBlock Text="{Binding PlatformConnectionGuide}" Style="{StaticResource Body}" TextWrapping="Wrap"
                                       FontSize="13.5" LineHeight="30" Margin="0,4,0,14" />
                            <Border Style="{StaticResource InnerPanel}" Padding="12">
                                <TextBlock Text="{Binding PlatformHdcpNote}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{Binding PlatformCapabilityNote}" Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- STEP 4 -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource EqualsToVis}, ConverterParameter=4}">
                            <TextBlock Text="These modes come from the driver, not from a fixed list. If a mode is missing, the hardware cannot deliver it."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <Border Style="{StaticResource InnerPanel}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Detected capture formats" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding CaptureFormatSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Capture resolution" Style="{StaticResource WizardLabel}" />
                                    <ComboBox Style="{StaticResource DarkCombo}" Height="36" ItemsSource="{Binding ResolutionOptions}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Frame rate" Style="{StaticResource WizardLabel}" />
                                    <ComboBox Style="{StaticResource DarkCombo}" Height="36" ItemsSource="{Binding FpsOptions}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedFps, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- STEP 5 -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource EqualsToVis}, ConverterParameter=5}">
                            <TextBlock Text="Set the video chain and pick the audio you want in the recording. Everything can be changed later."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Recording resolution" Style="{StaticResource WizardLabel}" />
                                    <ComboBox Style="{StaticResource DarkCombo}" Height="36" ItemsSource="{Binding ResolutionOptions}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />
                                    <TextBlock Text="Video codec" Style="{StaticResource WizardLabel}" Margin="0,12,0,5" />
                                    <ComboBox Style="{StaticResource DarkCombo}" Height="36" ItemsSource="{Binding Codecs}"
                                              DisplayMemberPath="Label" SelectedItem="{Binding SelectedCodec, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Microphone" Style="{StaticResource WizardLabel}" />
                                    <ItemsControl ItemsSource="{Binding AudioChannels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Visibility="{Binding Role, Converter={StaticResource RoleToVis}, ConverterParameter=mic}">
                                                    <ComboBox Style="{StaticResource DarkCombo}" Height="36" ItemsSource="{Binding Devices}"
                                                              DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Low latency mode" Style="{StaticResource WizardLabel}" Margin="0,6,0,5" />
                                    <ComboBox Style="{StaticResource DarkCombo}" Height="36" ItemsSource="{Binding LatencyModes}"
                                              SelectedItem="{Binding LatencyMode, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Style="{StaticResource Check}" Content="Record microphone and game audio on separate tracks" Margin="0,16,0,0"
                                      IsChecked="{Binding SeparateAudioTracks, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- STEP 6 -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource EqualsToVis}, ConverterParameter=6}">
                            <TextBlock Text="The test starts the real capture pipeline for a few seconds and reports what it actually measured."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <Button Style="{StaticResource AccentButton}" Height="40" HorizontalAlignment="Left"
                                    Content="Run capture test" Command="{Binding RunCaptureTestCommand}" />
                            <Border Style="{StaticResource InnerPanel}" Padding="14" Margin="0,16,0,0">
                                <TextBlock Text="{Binding WizardTestResult}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="If you see no frames: check the HDMI source, confirm the console is on, and make sure the card is not in use by another application."
                                       Style="{StaticResource CaptionTiny}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- STEP 7 -->
                        <StackPanel Visibility="{Binding WizardStep, Converter={StaticResource EqualsToVis}, ConverterParameter=7}">
                            <TextBlock Text="FIFINE Capture Studio is ready." Style="{StaticResource H2}" />
                            <TextBlock Text="The dashboard keeps the live preview, recording controls and mixer in one place. Global hotkeys are already bound:"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding HotkeyRecord, StringFormat=Start / stop recording  ·  {0}}" Style="{StaticResource Body}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding HotkeyPause, StringFormat=Pause / resume  ·  {0}}" Style="{StaticResource Body}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding HotkeyReplay, StringFormat=Save instant replay  ·  {0}}" Style="{StaticResource Body}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding HotkeyMute, StringFormat=Mute microphone  ·  {0}}" Style="{StaticResource Body}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding HotkeyPreview, StringFormat=Fullscreen preview  ·  {0}}" Style="{StaticResource Body}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- footer -->
                <Grid Grid.Row="2" Margin="26,18,26,22">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Back" Width="90"
                                Command="{Binding WizardBackCommand}"
                                Visibility="{Binding WizardCanGoBack, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="Skip setup" Width="110" Click="Skip_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource AccentButton}" Width="170" Height="40" Content="{Binding WizardPrimaryLabel}"
                                Command="{Binding WizardNextCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
