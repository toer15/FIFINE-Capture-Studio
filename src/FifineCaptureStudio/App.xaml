<Application x:Class="FifineCaptureStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FifineCaptureStudio.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml" />
                <ResourceDictionary Source="Theme/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:HalfValueConverter x:Key="HalfValue" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <conv:NullToVisibleConverter x:Key="NullToVisible" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:KeyToGeometryConverter x:Key="KeyToGeometry" />
            <conv:BooleanToStretchConverter x:Key="BoolToStretch" />
            <conv:ScaleTransformConverter x:Key="ScaleTransform" />
            <conv:EqualsToVisibilityConverter x:Key="EqualsToVis" />
            <conv:StepFillConverter x:Key="StepFill" />
            <conv:RoleToVisibilityConverter x:Key="RoleToVis" />
            <conv:ProgressWidthConverter x:Key="ProgressWidth" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
