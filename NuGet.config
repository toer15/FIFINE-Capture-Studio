<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The machine-wide NuGet configuration references a Godot offline folder that
       does not exist, so restore is pinned to nuget.org for this repository only. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
